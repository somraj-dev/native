<UserControl
    x:Class="AxioVital.Desktop.Widgets.MedicationListPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Pill Capsule Icon Resource -->
        <DataTemplate x:Key="CapsulePillIconTemplate">
            <Border Width="16" Height="9" CornerRadius="4.5" BorderBrush="#B22222" BorderThickness="0.8" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-45" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="#D83232" />
                    <Rectangle Grid.Column="1" Fill="#FFFFFF" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Cardboard DME Box Icon Resource -->
        <DataTemplate x:Key="CardboardBoxIconTemplate">
            <Grid Width="16" Height="14" Margin="0,1,0,0">
                <Polygon Points="8,1 15,4 15,10 8,13 1,10 1,4" Fill="#C9945B" Stroke="#8C5C2E" StrokeThickness="0.7" />
                <Polygon Points="8,1 1,4 8,7 15,4" Fill="#DCAE7A" Stroke="#8C5C2E" StrokeThickness="0.6" />
                <Line X1="8" Y1="1" X2="8" Y2="7" Stroke="#BF7E3D" StrokeThickness="1.2" />
                <Line X1="8" Y1="7" X2="8" Y2="13" Stroke="#8C5C2E" StrokeThickness="0.8" />
            </Grid>
        </DataTemplate>

        <!-- Cerner Compact RadioButton Style matching Image 1 1:1 -->
        <Style x:Key="CernerRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#7A8B99" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#223344" />
            <Setter Property="Padding" Value="5,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Outer Circle (13x13) -->
                            <Border x:Name="OuterEllipse"
                                    Grid.Column="0"
                                    Width="13"
                                    Height="13"
                                    CornerRadius="6.5"
                                    Background="#FFFFFF"
                                    BorderBrush="#7A8B99"
                                    BorderThickness="1.2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <!-- Inner Dot (5x5) -->
                                <Ellipse x:Name="InnerCheckGlyph"
                                         Width="5"
                                         Height="5"
                                         Fill="#083C64"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                            </Border>

                            <!-- Text Content -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              FontSize="{TemplateBinding FontSize}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="InnerCheckGlyph.Visibility" Value="Visible" />
                                            <Setter Target="OuterEllipse.BorderBrush" Value="#083C64" />
                                            <Setter Target="ContentPresenter.Foreground" Value="#083C64" />
                                            <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Modal Dialog Outer Root Layout -->
    <Grid x:Name="RootLayout" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="DialogBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="1180"
                Height="740"
                MinWidth="600"
                MinHeight="380"
                Background="#FFFFFF"
                BorderBrush="#063A60"
                BorderThickness="1"
                CornerRadius="0">

            <Border.RenderTransform>
                <TranslateTransform x:Name="DialogTranslate" X="0" Y="0" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0. Title Bar (Height: 28) -->
                    <RowDefinition Height="28" />
                    <!-- 1. Patient Banner (Height: 68) -->
                    <RowDefinition Height="68" />
                    <!-- 2. Action & Status Toolbar (Height: 34) -->
                    <RowDefinition Height="34" />
                    <!-- 3. Show Formulary link row (Height: 20) -->
                    <RowDefinition Height="20" />
                    <!-- 4. Scrollable Medication Comparison Table & Details Area -->
                    <RowDefinition Height="*" />
                    <!-- 5. Bottom Footer Action Bar (Height: 42) -->
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <!-- ==================== 0. MODAL TITLE BAR ==================== -->
                <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="#063C64" Padding="6,0,4,0"
                      PointerPressed="OnTitleBarPointerPressed"
                      PointerMoved="OnTitleBarPointerMoved"
                      PointerReleased="OnTitleBarPointerReleased"
                      DoubleTapped="OnTitleBarDoubleTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Icon [P] -->
                    <Border Grid.Column="0" Width="17" Height="17" Background="#032A46" BorderBrush="#1C72A8" BorderThickness="1" CornerRadius="1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="P" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>

                    <!-- Title Text -->
                    <TextBlock Grid.Column="1"
                               Text="Order Reconciliation: Outpatient - TESTPROD, ONE"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI" />

                    <!-- Window Action Buttons: Minimize, Maximize, Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- Minimize -->
                        <Button Width="24" Height="22" Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" CornerRadius="0">
                            <TextBlock Text="–" Foreground="#D2DFE8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Button>
                        <!-- Maximize -->
                        <Button Width="24" Height="22" Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="OnMaximizeClicked">
                            <TextBlock x:Name="MaximizeButtonText" Text="□" Foreground="#D2DFE8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Button>
                        <!-- Close ✕ -->
                        <Button Width="24" Height="22" Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="OnCloseClicked">
                            <TextBlock Text="✕" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

            <!-- ==================== 1. PATIENT BANNER ==================== -->
            <Grid Grid.Row="1" Background="#042C4C" Padding="10,6,12,6">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Avatar + Name + Portal + Loc -->
                    <ColumnDefinition Width="220" />
                    <!-- Column 1: PCP + Sex -->
                    <ColumnDefinition Width="200" />
                    <!-- Column 2: Age + DOB -->
                    <ColumnDefinition Width="120" />
                    <!-- Column 3: MRN + Attending + Outpatient Info -->
                    <ColumnDefinition Width="270" />
                    <!-- Column 4: Phone + Allergies + Amb Medicare -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Avatar + Details -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="#2C365C" BorderBrush="#1B527E" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                        <Canvas Width="44" Height="44">
                            <!-- Silhouette Head -->
                            <Ellipse Width="15" Height="17" Fill="#9C6ADE" Canvas.Left="14.5" Canvas.Top="6" />
                            <!-- Silhouette Body -->
                            <Path Fill="#9C6ADE" Data="M 7,40 C 7,29 14,25 22,25 C 30,25 37,29 37,40 Z" />
                        </Canvas>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="TESTPROD," Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" FontFamily="Segoe UI" />
                        <TextBlock Text="ONE" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,-2,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0">
                            <TextBlock Text="Patient Portal:" Foreground="#BACBD9" FontSize="10.5" />
                            <TextBlock Text="YES" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Loc: CHC Willard" Foreground="#70B5F5" FontSize="10.5" />
                    </StackPanel>
                </StackPanel>

                <!-- Col 1: PCP + Sex -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="PCP: TestUser, PX Physician - Family" Foreground="#FFFFFF" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Practice..." Foreground="#FFFFFF" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,-2,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                        <TextBlock Text="Sex:" Foreground="#BACBD9" FontSize="10.5" />
                        <TextBlock Text="Male" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Col 2: Age + DOB -->
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Age:" Foreground="#BACBD9" FontSize="10.5" />
                        <TextBlock Text="46 years" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="DOB:" Foreground="#BACBD9" FontSize="10.5" />
                    <TextBlock Text="11/12/1970" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" Margin="0,-2,0,0" />
                </StackPanel>

                <!-- Col 3: MRN + Attending + Fin -->
                <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="MRN:" Foreground="#BACBD9" FontSize="10.5" />
                        <TextBlock Text="AM00000380" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Attending:" Foreground="#BACBD9" FontSize="10.5" />
                        <TextBlock Text="Krenn MD, Louis P" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="Outpatient AM000001313324 [10/25/2016 1:00... &lt;No - Disc..." Foreground="#AECDE8" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Col 4: Phone + Allergies + Amb Medicare -->
                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="(417) 555-5555" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <TextBlock Text="Allergies:" Foreground="#FF6E6E" FontSize="10.5" FontWeight="Bold" />
                        <TextBlock Text="Ultram, sulfa drugs, amoxicillin,..." Foreground="#FF6E6E" FontSize="10.5" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="AMB-MEDICARE SERVICES-CARE" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- ==================== 2. ACTION & RECONCILIATION STATUS TOOLBAR ==================== -->
            <Grid Grid.Row="2" Background="#FFFFFF" Padding="12,0,12,0" BorderBrush="#CBD8E6" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Links: + Add | Rx Plans -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" Click="OnAddClicked">
                        <TextBlock Text="+ Add" Foreground="#0B5DA4" FontSize="11.5" FontWeight="Bold" TextDecorations="Underline" />
                    </Button>

                    <TextBlock Text="|" Foreground="#BAC5D0" FontSize="11.5" VerticalAlignment="Center" Margin="2,0" />

                    <Button Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="Rx Plans" Foreground="#0B5DA4" FontSize="11.5" FontWeight="SemiBold" TextDecorations="Underline" />
                            <TextBlock Text=" (0): No Benefit Found *" Foreground="#333333" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Radio Buttons: Reconciliation Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Reconciliation Status" FontSize="11.5" FontWeight="Normal" Foreground="#222222" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <RadioButton Style="{StaticResource CernerRadioButtonStyle}" Content="Meds History" GroupName="ReconciliationStatusGroup" IsChecked="False" />
                    <RadioButton Style="{StaticResource CernerRadioButtonStyle}" Content="Admission" GroupName="ReconciliationStatusGroup" IsChecked="False" />
                    <RadioButton Style="{StaticResource CernerRadioButtonStyle}" Content="Outpatient" GroupName="ReconciliationStatusGroup" IsChecked="True" />
                </StackPanel>
            </Grid>

            <!-- ==================== 3. SHOW FORMULARY LINK ROW ==================== -->
            <Grid Grid.Row="3" Background="#FFFFFF" Padding="0,2,12,2">
                <Button HorizontalAlignment="Right" Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="Show Formulary... ▼" Foreground="#0B5DA4" FontSize="11" TextDecorations="Underline" />
                </Button>
            </Grid>

            <!-- ==================== 4. COMPARISON TABLE & DETAILS SECTION ==================== -->
            <ScrollViewer Grid.Row="4" Background="#FFFFFF" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Two Column Headers: Orders Prior vs Orders After -->
                    <Grid Background="#E2EEF8" BorderBrush="#B4CCE2" BorderThickness="0,1,0,1" MinHeight="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Header -->
                        <TextBlock Grid.Column="0"
                                   Text="Orders Prior to Reconciliation"
                                   Foreground="#2C4662"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="10,4,0,4" />

                        <!-- Vertical Divider -->
                        <Rectangle Grid.Column="1" Fill="#B4CCE2" />

                        <!-- Right Header -->
                        <TextBlock Grid.Column="2"
                                   Text="Orders After Reconciliation"
                                   Foreground="#2C4662"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="10,4,0,4" />
                    </Grid>

                    <!-- Section Header: ▲ Home Medications -->
                    <Border Background="#EEF5FC" BorderBrush="#DDEAF5" BorderThickness="0,0,0,1" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="▲" Foreground="#083256" FontSize="9" VerticalAlignment="Center" />
                            <TextBlock Text="Home Medications" Foreground="#083256" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- MEDICATION ROWS CONTAINER -->
                    <StackPanel x:Name="MedicationsTableList">

                        <!-- Row 1: acetaminophen-hydrocodone -->
                        <Grid Background="#FFFFFF" BorderBrush="#E8EEF5" BorderThickness="0,0,0,1" MinHeight="44" Padding="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Prior Column -->
                            <Grid Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="▼" Foreground="#8898A6" FontSize="8" VerticalAlignment="Center" />
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="acetaminophen-hydrocodone (Norco 5 mg-..." Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="1 tab, By mouth, 6AM, PRN: for pain, 1 tab, PO..." Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Prescribed" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>

                            <Rectangle Grid.Column="1" Fill="#E2EBF4" />

                            <!-- After Column -->
                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="acetaminophen-hydrocodone (Norco 5 mg-..." Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="1 tab, By mouth, 6AM, PRN: for pain, 1 tab, P... &lt;Notes...&gt;" Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Prescribed" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                        </Grid>

                        <!-- Row 2: ALPRAZolam (Xanax 0.5 mg oral tablet) -->
                        <Grid Background="#FFFFFF" BorderBrush="#E8EEF5" BorderThickness="0,0,0,1" MinHeight="44" Padding="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="▼" Foreground="#8898A6" FontSize="8" VerticalAlignment="Center" />
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ALPRAZolam (Xanax 0.5 mg oral tablet)" Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="0.5 mg, By mouth, BID, 60 tab, 0 Refill(s)" Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Prescribed" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>

                            <Rectangle Grid.Column="1" Fill="#E2EBF4" />

                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ALPRAZolam (Xanax 0.5 mg oral tablet)" Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="0.5 mg, By mouth, BID, 60 tab, 0 Re... &lt;Notes...&gt;" Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Prescribed" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                        </Grid>

                        <!-- Row 3: ibuprofen (Ibuprofen 800 mg oral tablet) -->
                        <Grid Background="#FFFFFF" BorderBrush="#E8EEF5" BorderThickness="0,0,0,1" MinHeight="44" Padding="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="▼" Foreground="#8898A6" FontSize="8" VerticalAlignment="Center" />
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ibuprofen (Ibuprofen 800 mg oral tablet)" Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="800 mg, 1 tab, By mouth, TID, 270 tab, 0 Refill(s)" Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Documented" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>

                            <Rectangle Grid.Column="1" Fill="#E2EBF4" />

                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ibuprofen (Ibuprofen 800 mg oral tablet)" Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="800 mg, 1 tab, By mouth, TID, 270 t... &lt;Notes...&gt;" Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Acknowledged" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                        </Grid>

                        <!-- Row 4: lisinopril (lisinopril 10 mg oral tablet) -->
                        <Grid Background="#FFFFFF" BorderBrush="#E8EEF5" BorderThickness="0,0,0,1" MinHeight="44" Padding="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="▼" Foreground="#8898A6" FontSize="8" VerticalAlignment="Center" />
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="lisinopril (lisinopril 10 mg oral tablet)" Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="10 mg, 1 tab, By mouth, Daily, 90 tab, 0 Refill(s)" Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Prescribed" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>

                            <Rectangle Grid.Column="1" Fill="#E2EBF4" />

                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ContentPresenter ContentTemplate="{StaticResource CapsulePillIconTemplate}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="lisinopril (lisinopril 10 mg oral tablet)" Foreground="#082848" FontSize="11.5" FontWeight="Bold" />
                                        <TextBlock Text="10 mg, 1 tab, By mouth, Daily, 90 t... &lt;Notes...&gt;" Foreground="#556677" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Prescribed" Foreground="#223344" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                        </Grid>

                        <!-- Row 5: lisinopril (lisinopril 30 mg oral tablet) -->
