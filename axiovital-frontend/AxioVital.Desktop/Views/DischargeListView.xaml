<UserControl
    x:Class="AxioVital.Desktop.Views.DischargeListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AxioVital.Desktop.Models"
    mc:Ignorable="d"
    FontFamily="Segoe UI">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <!-- 0. Header Summary -->
            <RowDefinition Height="Auto" />
            <!-- 1. Data Table Area with Column Headers -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Total Patients Summary Header -->
        <Grid Grid.Row="0" Background="White" Padding="14,8,14,8" BorderBrush="#E2E6EA" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TotalPatientsBannerText" Text="Total Patients: 38" Foreground="#002D4A" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== 1. MAIN DATA TABLE WITH COLUMN HEADERS ==================== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Row -->
                    <RowDefinition Height="28" />
                    <!-- Items Container -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers (Styling matches PatientListView / screenshot) -->
                <Grid Grid.Row="0" Background="#E2EAF0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />   <!-- 0. MRN -->
                        <ColumnDefinition Width="105" />  <!-- 1. Axio ID -->
                        <ColumnDefinition Width="200" />  <!-- 2. Patient Name -->
                        <ColumnDefinition Width="105" />  <!-- 3. Age / Gender -->
                        <ColumnDefinition Width="85" />   <!-- 4. DOB -->
                        <ColumnDefinition Width="140" />  <!-- 5. Admitted On -->
                        <ColumnDefinition Width="155" />  <!-- 6. Discharge Date/Time -->
                        <ColumnDefinition Width="165" />  <!-- 7. Department / Unit -->
                        <ColumnDefinition Width="160" />  <!-- 8. Attending Physician -->
                        <ColumnDefinition Width="175" />  <!-- 9. Status / Workflow -->
                        <ColumnDefinition Width="195" />  <!-- 10. Destination / Disposition -->
                        <ColumnDefinition Width="180" />  <!-- 11. Discharge Summary Status -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="MRN" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="UUID / Axio ID" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Patient Name" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Age / Gender" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="DOB" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="5" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Admitted On" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="6" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Discharge Date / Time" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="7" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Department / Unit" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="8" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Attending Physician" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="9" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Status / Workflow" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="10" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Disposition / Destination" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="11" BorderBrush="#C2D3E0" BorderThickness="0,0,0,1" Padding="6,2">
                        <TextBlock Text="Discharge Summary" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Data Rows Container (ItemsControl) -->
                <ItemsControl x:Name="DischargeItemsControl" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DischargePatientItem">
                            <Border BorderBrush="#E2E6EA" BorderThickness="0,0,0,1" Background="{x:Bind RowBackground}" PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85" />   <!-- 0. MRN -->
                                        <ColumnDefinition Width="105" />  <!-- 1. Axio ID -->
                                        <ColumnDefinition Width="200" />  <!-- 2. Patient Name -->
                                        <ColumnDefinition Width="105" />  <!-- 3. Age / Gender -->
                                        <ColumnDefinition Width="85" />   <!-- 4. DOB -->
                                        <ColumnDefinition Width="140" />  <!-- 5. Admitted On -->
                                        <ColumnDefinition Width="155" />  <!-- 6. Discharge Date/Time -->
                                        <ColumnDefinition Width="165" />  <!-- 7. Department / Unit -->
                                        <ColumnDefinition Width="160" />  <!-- 8. Attending Physician -->
                                        <ColumnDefinition Width="175" />  <!-- 9. Status / Workflow -->
                                        <ColumnDefinition Width="195" />  <!-- 10. Destination / Disposition -->
                                        <ColumnDefinition Width="180" />  <!-- 11. Discharge Summary Status -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 0. MRN -->
                                    <Border Grid.Column="0" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind MRN}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 1. Axio ID -->
                                    <Border Grid.Column="1" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind AxioId}" Foreground="#475569" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 2. Patient Name (Clickable Bold Blue Link) -->
                                    <Border Grid.Column="2" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind PatientName}" 
                                                   Foreground="#0A658E" 
                                                   FontWeight="Bold" 
                                                   FontSize="11.5" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   PointerPressed="OnPatientNamePointerPressed" 
                                                   Tag="{x:Bind PatientName}" />
                                    </Border>

                                    <!-- 3. Age / Gender -->
                                    <Border Grid.Column="3" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind AgeGender}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 4. DOB -->
                                    <Border Grid.Column="4" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind DOB}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 5. Admitted On -->
                                    <Border Grid.Column="5" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind AdmittedOn}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 6. Discharge Date / Time -->
                                    <Border Grid.Column="6" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind DischargeDateTime}" Foreground="#1E293B" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 7. Department / Unit -->
                                    <Border Grid.Column="7" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind LocationUnit}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 8. Attending Physician -->
                                    <Border Grid.Column="8" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind AttendingPhysician}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 9. Status / Workflow Pill -->
                                    <Border Grid.Column="9" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="4,1" VerticalAlignment="Center">
                                        <Border CornerRadius="3" 
                                                Padding="6,2" 
                                                HorizontalAlignment="Left"
                                                Background="{x:Bind StatusBackground}"
                                                BorderBrush="{x:Bind StatusBorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{x:Bind StatusBadgeText}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{x:Bind StatusForeground}" 
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Border>

                                    <!-- 10. Destination / Disposition -->
                                    <Border Grid.Column="10" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind Disposition}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 11. Discharge Summary Status -->
                                    <Border Grid.Column="11" Padding="6,1">
                                        <TextBlock Text="{x:Bind DischargeSummaryStatus}" Foreground="{x:Bind SummaryStatusForeground}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
