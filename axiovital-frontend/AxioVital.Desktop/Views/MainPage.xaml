<Page
    x:Class="AxioVital.Desktop.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AxioVital.Desktop.Models"
    xmlns:views="using:AxioVital.Desktop.Views"
    mc:Ignorable="d"
    Background="#F4F5F7">


    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Topmost Nav Bar 1 -->
            <RowDefinition Height="Auto" />
            <!-- 1. Sub Nav Bar 2 -->
            <RowDefinition Height="Auto" />
            <!-- 2. Category Bar 3 -->
            <RowDefinition Height="Auto" />
            <!-- 3. Dark Blue Header Bar 4 -->
            <RowDefinition Height="Auto" />
            <!-- 4. Light Blue Tab Strip Bar 5 -->
            <RowDefinition Height="Auto" />
            <!-- 5. Deep Blue Patient Demographic Banner -->
            <RowDefinition Height="Auto" />
            <!-- 6. Main Content Area (Patient Profile OR Message Center) -->
            <RowDefinition Height="*" />
            <!-- 7. Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. TOP RIBBON OPTIONS BAR ==================== -->
        <Grid x:Name="TopRibbonBarGrid" Grid.Row="0" Background="#F2F3F5" Padding="10,3,10,3" BorderBrush="#D5D9E0" BorderThickness="0,0,0,1" MinHeight="28">
            <Grid.Resources>
                <Style x:Key="TopRibbonMenuItemStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="3" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="TopRibbonHomeButton" Style="{StaticResource TopRibbonMenuItemStyle}" Click="OnHomeButtonClick">
                    <TextBlock Text="Home" Foreground="#111111" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="TopRibbonLedgerButton" Style="{StaticResource TopRibbonMenuItemStyle}" Click="OnLedgerButtonClick">
                    <TextBlock Text="Ledger" Foreground="#333333" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="TopRibbonAmbulatoryButton" Style="{StaticResource TopRibbonMenuItemStyle}">
                    <TextBlock x:Name="TopRibbonAmbulatoryText" Text="Ambulatory" Foreground="#333333" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <Flyout x:Name="TopRibbonAmbulatoryFlyout" Placement="BottomEdgeAlignedLeft" Opened="OnTopRibbonAmbulatoryFlyoutOpened" Closed="OnTopRibbonAmbulatoryFlyoutClosed">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="2" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MinWidth" Value="200" />
                                    <Setter Property="MaxWidth" Value="240" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Border Background="White" Width="210" Padding="0,4,0,4">
                                <StackPanel x:Name="AmbulatoryDropdownList">
                                    <!-- Item 1: Appointment Request -->
                                    <Border Padding="16,6" Background="Transparent" PointerEntered="OnAmbulatoryItemPointerEntered" PointerExited="OnAmbulatoryItemPointerExited" PointerPressed="OnAmbulatoryCustomItemPressed" Tag="amb_appointment_request">
                                        <TextBlock Text="Appointment Request" FontSize="11.5" Foreground="#1E293B" />
                                    </Border>

                                    <!-- Separator -->
                                    <Rectangle Fill="#E2E8F0" Height="1" Margin="8,4,8,4" />

                                    <!-- Item 3: Referrals & Transfer -->
                                    <Border Padding="16,6" Background="Transparent" PointerEntered="OnAmbulatoryItemPointerEntered" PointerExited="OnAmbulatoryItemPointerExited" PointerPressed="OnAmbulatoryCustomItemPressed" Tag="amb_referrals_transfer">
                                        <TextBlock Text="Referrals &amp; Transfer" FontSize="11.5" Foreground="#1E293B" />
                                    </Border>

                                    <!-- Item 4: Discharge List -->
                                    <Border Padding="16,6" Background="Transparent" PointerEntered="OnAmbulatoryItemPointerEntered" PointerExited="OnAmbulatoryItemPointerExited" PointerPressed="OnAmbulatoryCustomItemPressed" Tag="amb_discharge_list">
                                        <TextBlock Text="Discharge List" FontSize="11.5" Foreground="#1E293B" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="TopRibbonClinicalButton" Style="{StaticResource TopRibbonMenuItemStyle}">
                    <TextBlock x:Name="TopRibbonClinicalText" Text="Clinical" Foreground="#333333" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <Flyout x:Name="TopRibbonClinicalFlyout" Placement="BottomEdgeAlignedLeft" Opened="OnTopRibbonClinicalFlyoutOpened" Closed="OnTopRibbonClinicalFlyoutClosed">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="2" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MinWidth" Value="230" />
                                    <Setter Property="MaxWidth" Value="250" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Border Background="White" Width="235" Padding="0,4,0,4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="540">
                                    <StackPanel x:Name="ClinicalDropdownList">
                                        <!-- Group 1: Core Clinical Views -->
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_provider_view">
                                            <TextBlock Text="Provider View" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_results_review">
                                            <TextBlock Text="Results Review" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_orders">
                                            <TextBlock Text="Orders" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_documentation">
                                            <TextBlock Text="Documentation" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_outside_records">
                                            <TextBlock Text="Outside Records" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>

                                        <!-- Separator -->
                                        <Rectangle Height="1" Fill="#E2E8F0" Margin="10,3,10,3" />

                                        <!-- Group 2: Specific Clinical Data & Panels -->
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_allergies">
                                            <TextBlock Text="Allergies" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_clinical_media">
                                            <TextBlock Text="Clinical Media" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_diagnoses">
                                            <TextBlock Text="Diagnoses and Problems" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_form_browser">
                                            <TextBlock Text="Form Browser" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_growth_chart">
                                            <TextBlock Text="Growth Chart" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_histories">
                                            <TextBlock Text="Histories" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_interactive_view">
                                            <TextBlock Text="Interactive View and I/O" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_mar_summary">
                                            <TextBlock Text="MAR Summary" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_medication_list">
                                            <TextBlock Text="Medication List" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_patient_info">
                                            <TextBlock Text="Patient Information" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_recommendations">
                                            <TextBlock Text="Recommendations" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_smart_app_validator">
                                            <TextBlock Text="Smart App Validator" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>

                                        <!-- Separator -->
                                        <Rectangle Height="1" Fill="#E2E8F0" Margin="10,3,10,3" />

                                        <!-- Group 3: AxioNote & Edge Tools -->
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_axionote_note">
                                            <TextBlock Text="AxioNote - Clinical Note" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border x:Name="ClinicalItemAxioNoteEdge" Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_axionote_edge">
                                            <TextBlock Text="AxioNote - Edge Platform" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_axionote_enterprise">
                                            <TextBlock Text="AxioNote - Enterprise" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_workflowview_edge">
                                            <TextBlock Text="WorkflowView Edge" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_axionote_dev">
                                            <TextBlock Text="AxioNote Dev - Edge" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_axionote_debug">
                                            <TextBlock Text="AxioNote Debug EDGE" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>

                                        <!-- Separator -->
                                        <Rectangle Height="1" Fill="#E2E8F0" Margin="10,3,10,3" />

                                        <!-- Group 4: Clinical Utilities & Billing -->
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_calculator">
                                            <TextBlock Text="Clinical Calculator" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_adhoc_charting">
                                            <TextBlock Text="Ad Hoc Charting" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                        <Border Padding="16,4.5" Background="Transparent" PointerEntered="OnClinicalItemPointerEntered" PointerExited="OnClinicalItemPointerExited" PointerPressed="OnClinicalCustomItemPressed" Tag="clin_view_charges">
                                            <TextBlock Text="View Charges" FontSize="11.5" Foreground="#1E293B" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="TopRibbonNotificationsButton" Style="{StaticResource TopRibbonMenuItemStyle}" Click="OnNotificationsButtonClick">
                    <TextBlock x:Name="TopRibbonNotificationsText" Text="Notifications" Foreground="#333333" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="TopRibbonAdminButton" Style="{StaticResource TopRibbonMenuItemStyle}" Click="OnAdminButtonClick">
                    <TextBlock Text="Admin" Foreground="#333333" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="TopRibbonHelpButton" Style="{StaticResource TopRibbonMenuItemStyle}">
                    <TextBlock Text="Help" Foreground="#333333" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <Flyout x:Name="TopRibbonHelpFlyout" Placement="BottomEdgeAlignedLeft" Opened="OnTopRibbonHelpFlyoutOpened">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="2" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MinWidth" Value="220" />
                                    <Setter Property="MaxWidth" Value="220" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Border Background="White" Width="220" Padding="0,4,0,4">
                                <StackPanel>
                                    <Border Padding="14,5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_welcome">
                                        <TextBlock Text="Welcome" FontSize="11.5" Foreground="#1E293B" />
                                    </Border>
                                    <Border Padding="14,5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_commands">
                                        <Grid>
                                            <TextBlock Text="Show All Commands" FontSize="11.5" Foreground="#1E293B" />
                                            <TextBlock Text="Ctrl+Shift+P" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- Editor Playground Button with nested Sub-Flyout -->
                                    <Button x:Name="EditorPlaygroundMenuButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" MinWidth="0" PointerEntered="OnEditorPlaygroundPointerEntered" PointerExited="OnEditorPlaygroundPointerExited" Click="OnEditorPlaygroundMenuButtonClick">
                                        <Border x:Name="HelpEditorPlaygroundRow" Padding="14,5" Background="Transparent">
                                            <Grid>
                                                <TextBlock x:Name="HelpEditorPlaygroundText" Text="Editor Playground" FontSize="11.5" Foreground="#1E293B" />
                                                <FontIcon x:Name="HelpEditorPlaygroundIcon" Glyph="&#xE76C;" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout x:Name="EditorPlaygroundSubFlyout" Placement="RightEdgeAlignedTop">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="CornerRadius" Value="2" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                        <Setter Property="MinWidth" Value="260" />
                                                        <Setter Property="MaxWidth" Value="260" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <Border Background="White" Width="260" Padding="0,4,0,4">
                                                    <StackPanel>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_cmd_palette">
                                                            <Grid>
                                                                <TextBlock Text="Command Palette..." FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+P" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="#0A658E" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_open_view">
                                                            <TextBlock Text="Open View..." FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                        <Rectangle Height="1" Fill="#E2E8F0" Margin="10,2.5,10,2.5" />
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_appearance">
                                                            <Grid>
                                                                <TextBlock Text="Appearance" FontSize="11.5" Foreground="#1E293B" />
                                                                <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_editor_layout">
                                                            <Grid>
                                                                <TextBlock Text="Editor Layout" FontSize="11.5" Foreground="#1E293B" />
                                                                <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Rectangle Height="1" Fill="#E2E8F0" Margin="10,2.5,10,2.5" />
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_explorer">
                                                            <Grid>
                                                                <TextBlock Text="Explorer" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+E" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_search">
                                                            <Grid>
                                                                <TextBlock Text="Search" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+F" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_scm">
                                                            <Grid>
                                                                <TextBlock Text="Source Control" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+G G" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_run">
                                                            <Grid>
                                                                <TextBlock Text="Run" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+D" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_extensions">
                                                            <Grid>
                                                                <TextBlock Text="Extensions" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+X" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_testing">
                                                            <TextBlock Text="Testing" FontSize="11.5" Foreground="#1E293B" />
                                                        </Border>
                                                        <Rectangle Height="1" Fill="#E2E8F0" Margin="10,2.5,10,2.5" />
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_problems">
                                                            <Grid>
                                                                <TextBlock Text="Problems" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+M" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_output">
                                                            <Grid>
                                                                <TextBlock Text="Output" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+U" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_debug_console">
                                                            <Grid>
                                                                <TextBlock Text="Debug Console" FontSize="11.5" Foreground="#1E293B" />
                                                                <TextBlock Text="Ctrl+Shift+Y" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Padding="14,4.5" Background="Transparent" PointerEntered="OnHelpItemPointerEntered" PointerExited="OnHelpItemPointerExited" PointerPressed="OnHelpCustomItemPressed" Tag="help_terminal">
                                                            <Grid>
