<Page
    x:Class="AxioVital.Desktop.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AxioVital.Desktop.Models"
    mc:Ignorable="d"
    Background="#F4F5F7">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Topmost Nav Bar 1 -->
            <RowDefinition Height="Auto" />
            <!-- 1. Sub Nav Bar 2 -->
            <RowDefinition Height="Auto" />
            <!-- 2. Category Bar 3 -->
            <RowDefinition Height="Auto" />
            <!-- 3. Dark Blue Header Bar 4 -->
            <RowDefinition Height="Auto" />
            <!-- 4. Light Blue Tab Strip Bar 5 -->
            <RowDefinition Height="Auto" />
            <!-- 5. Deep Blue Patient Demographic Banner -->
            <RowDefinition Height="Auto" />
            <!-- 6. Main Content Area (Patient Profile OR Message Center) -->
            <RowDefinition Height="*" />
            <!-- 7. Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. TOP RIBBON OPTIONS BAR ==================== -->
        <Grid x:Name="TopRibbonBarGrid" Grid.Row="0" Background="#F2F3F5" Padding="12,4,12,4" BorderBrush="#D5D9E0" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Home" Foreground="#111111" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Ledger" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="ambulatory" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Clinical" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Notifications" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Admin" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Help" Foreground="#333333" FontSize="11" FontWeight="Normal" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="#555555" />
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#555555" />
                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="#555555" />
            </StackPanel>
        </Grid>

        <!-- ==================== 1. SUB NAV BAR 2 ==================== -->
        <Grid x:Name="SubNavBarGrid" Grid.Row="1" Background="#FFFFFF" Padding="12,5,12,5" BorderBrush="#D0D4DC" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Message Center Tab Button -->
                <Border x:Name="MessageCenterTabBorder" Padding="0,0,0,3" PointerPressed="OnMessageCenterTabPointerPressed">
                    <TextBlock x:Name="MessageCenterTabText" Text="Message Center" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                </Border>

                <!-- Patient List Tab Button -->
                <Border x:Name="PatientListTabBorder" BorderBrush="#0A658E" BorderThickness="0,0,0,2" Padding="0,0,0,3" PointerPressed="OnPatientListTabPointerPressed">
                    <TextBlock x:Name="PatientListTabText" Text="Patient List" Foreground="#0A658E" FontSize="11" FontWeight="Bold" />
                </Border>

                <TextBlock Text="Physician Handoff" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Care Workflow" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Quality Measures" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Customised" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Reports" Foreground="#111111" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="UpToDate" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Ongoing Activities" Foreground="#333333" FontSize="11" FontWeight="Normal" />
            </StackPanel>

            <FontIcon Grid.Column="1" Glyph="&#xE712;" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== 2. CATEGORY BAR 3 ==================== -->
        <Grid x:Name="CategoryBarGrid" Grid.Row="2" Background="#EEF2F6" Padding="12,4,12,4" BorderBrush="#CBD0D8" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="Dashboard" Foreground="#444444" FontSize="11" />
                <TextBlock Text="Scheduler" Foreground="#111111" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Order Sets" Foreground="#111111" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Care Pathways" Foreground="#444444" FontSize="11" />
                <TextBlock Text="Labs" Foreground="#444444" FontSize="11" />
                <TextBlock Text="Analytics" Foreground="#444444" FontSize="11" />
            </StackPanel>

            <FontIcon Grid.Column="1" Glyph="&#xE712;" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== 3. DARK BLUE HEADER BAR 4 ==================== -->
        <Grid x:Name="DarkHeaderBarGrid" Grid.Row="3" Background="#0A527B" Padding="12,3,12,3" MinHeight="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HeaderTitleText" Grid.Column="0" Text="Patient Profile" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />

            <!-- Quick Tools Right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Background="#021826" CornerRadius="5" Padding="8,2,8,2" Height="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" FontSize="11" VerticalAlignment="Center" />
                        <TextBox PlaceholderText="Search by Patient or Order..." Background="Transparent" Foreground="White" BorderThickness="0" FontSize="11" Width="185" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" PointerPressed="OnFullScreenPointerPressed">
                    <FontIcon Glyph="&#xE740;" FontSize="11" Foreground="White" />
                    <TextBlock Text="Full screen" Foreground="White" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE749;" FontSize="11" Foreground="White" />
                    <TextBlock Text="Print" Foreground="White" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="White" />
                    <TextBlock Text="0 minutes ago" Foreground="White" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ==================== 4. LIGHT BLUE TAB STRIP BAR 5 ==================== -->
        <Grid x:Name="TabStripBarGrid" Grid.Row="4" Background="#BACBD4" Padding="12,4,12,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Border x:Name="PatientProfileTabPill" Background="#E6EEF2" CornerRadius="3,3,0,0" Padding="12,5,12,5" PointerPressed="OnPatientListTabPointerPressed">
                    <TextBlock Text="Patient Profile: JOHN DOE" Foreground="#0A3F5C" FontSize="11" FontWeight="Bold" />
                </Border>
                <Border x:Name="MessageCenterTabPill" Background="#FFFFFF" CornerRadius="3,3,0,0" Padding="12,5,12,5" Visibility="Collapsed" PointerPressed="OnMessageCenterTabPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="General Messages: JOHN DOE" Foreground="#0A3F5C" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="✕" Foreground="#777777" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== 5. DEEP BLUE PATIENT DEMOGRAPHIC BANNER ==================== -->
        <Grid x:Name="PatientDemographicBanner" Grid.Row="5" Background="#005C8A" Padding="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse Fill="White" />
                <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="#005C8A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="JOHN DOE" Foreground="White" FontSize="15" FontWeight="Bold" />
                <TextBlock Text="Allergies: shellfish" Foreground="#D0E4F0" FontSize="10" />
                <TextBlock Text="Care Team: View Details" Foreground="#99CCE6" FontSize="10" TextDecorations="Underline" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="DOB: 3/22/1984" Foreground="White" FontSize="10" />
                <TextBlock Text="Dose Wt: 80.000 kg (04/25/2021)" Foreground="White" FontSize="10" />
                <TextBlock Text="HealthLife: No" Foreground="White" FontSize="10" />
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Age: 39 years" Foreground="White" FontSize="10" />
                <TextBlock Text="LTD:" Foreground="White" FontSize="10" />
                <TextBlock Text="Clinic: 01XTO" Foreground="White" FontSize="10" />
            </StackPanel>

            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Sex: Female" Foreground="White" FontSize="10" />
                <TextBlock Text="Code Status: Active" Foreground="White" FontSize="10" />
                <TextBlock Text="Loc: GLW-01" Foreground="White" FontSize="10" />
            </StackPanel>

            <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="MRN: AVX-SL-A1H4XE" Foreground="White" FontSize="10" />
                <TextBlock Text="Nominee: Mr. Ajan Singh" Foreground="White" FontSize="10" />
                <TextBlock Text="Inpatient FIN: 00095576415 [Admit Dt: 10/6/2020 3:14:12 PM CDT]" Foreground="White" FontSize="10" />
            </StackPanel>

            <Button Grid.Column="6" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center" Margin="8,0,0,0" x:Name="PatientActionsMenuButton">
                <FontIcon Glyph="&#xE700;" FontSize="18" Foreground="White" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#CCCCCC" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="MinWidth" Value="220" />
                                <Setter Property="RequestedTheme" Value="Light" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        
                        <Border Background="White" Padding="0,6,0,6" Width="220" RequestedTheme="Light">
                            <StackPanel Spacing="0">
                                <TextBlock Text="Bed Transfer" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Cancel Discharge" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Cancel Pending Discharge" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Cancel Pending Transfer" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Cancel Transfer" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Clozapine Registry" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Discharge Encounter" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Facility Transfer" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Leave of Absence" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Modify Discharge" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Pending Discharge" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Pending Facility Transfer" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Pending Transfer" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Print Labels" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Process Alert" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="Update Patient Information" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="View Encounter" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                                <TextBlock Text="View Person" Foreground="#222222" FontSize="12" Padding="14,5,14,5" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ==================== 6. MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="6">

            <!-- PATIENT PROFILE VIEW CONTENT -->
            <Grid x:Name="PatientProfileView" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Grid Grid.Column="0" Background="#0A3F5C">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8,12,8" Background="#062B40">
                        <TextBlock Text="Menu" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0">
                            <TextBlock Text="Documentation" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Outside Records" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Allergies" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Clinical Media" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Diagnoses and Problems" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Form Browser" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Growth Chart" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Insurance" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Histories" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Interactive View and I&amp;O" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="MAR Summary" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Medication List" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Recommendations" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="Smart App Validator" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="mTuitive - OpNote Test - IE" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="mTuitive - OpNote Test - Edge" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            
                            <Border Background="#005C8A" Padding="12,7,12,7">
                                <TextBlock Text="Op Note - Prod - Edge" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="WorkflowView Edge" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="mTuitive Dev - Edge" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                            <TextBlock Text="mTuitive Debug EDGE" Foreground="White" FontSize="11" Padding="12,6,12,6" />
                        </StackPanel>
                    </ScrollViewer>


                </Grid>

                <!-- Form Area -->
                <ScrollViewer Grid.Column="1" Background="White" Padding="32,24,32,24">
                    <StackPanel Width="560" HorizontalAlignment="Left" Spacing="20">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Implant Lot #: (optional)" Foreground="#555555" FontSize="12" FontStyle="Italic" />
                            <TextBox Height="90" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="2" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Was dermal matrix used?: (optional)" Foreground="#555555" FontSize="12" FontStyle="Italic" />
                            <StackPanel Spacing="6" Margin="10,0,0,0">
                                <RadioButton Content="Yes" FontSize="12" Foreground="#333333" />
                                <RadioButton Content="No" FontSize="12" Foreground="#333333" />
                                <RadioButton Content="Unknown" FontSize="12" Foreground="#333333" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Operative Description: (optional)" Foreground="#555555" FontSize="12" FontStyle="Italic" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" PlaceholderText="Choose an option" HorizontalAlignment="Stretch" Height="30" BorderBrush="#BBBBBB" CornerRadius="2" />
                                <TextBlock Grid.Column="1" Text="Other..." Foreground="#005C8A" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Comments: (optional)" Foreground="#555555" FontSize="12" FontStyle="Italic" />
                            <TextBox Height="90" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="2" />
                        </StackPanel>

                        <StackPanel Spacing="10" Margin="0,10,0,0">
                            <Border Background="#FFFF00" Padding="8,4,8,4" HorizontalAlignment="Left">
                                <TextBlock Text="Other Comments" Foreground="Black" FontSize="13" FontWeight="Bold" />
                            </Border>

                            <StackPanel Spacing="6">
                                <Border Background="#FFFF00" Padding="4,2,4,2" HorizontalAlignment="Left">
                                    <TextBlock Text="Other Comments:" Foreground="Black" FontSize="12" FontWeight="Bold" />
                                </Border>

                                <TextBox
                                    Height="80"
                                    Text="I am signing this report at the direction of administration, in the absence of Cerner Surgeon 1."
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    Foreground="#333333"
                                    BorderBrush="#BBBBBB"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== 1:1 MIRROR REPLICA MESSAGE CENTER VIEW ==================== -->
            <Grid x:Name="MessageCenterView" Visibility="Collapsed" Background="White">
                <Grid.RowDefinitions>
                    <!-- Action Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Data Table -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Message Action Toolbar -->
                <Grid Grid.Row="0" Background="#F0F3F6" Padding="12,6,12,6" BorderBrush="#CBD0D8" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE789;" FontSize="11" Foreground="#C82333" />
                            <TextBlock Text="Communicate ▾" Foreground="#333333" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#D97706" />
                            <TextBlock Text="Open" Foreground="#333333" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontSize="11" Foreground="#0A658E" />
                            <TextBlock Text="Message Journal" Foreground="#333333" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72A;" FontSize="11" Foreground="#0A658E" />
                            <TextBlock Text="Forward Only" Foreground="#333333" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE77B;" FontSize="11" Foreground="#444444" />
                            <TextBlock Text="Select Patient" Foreground="#333333" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73A;" FontSize="11" Foreground="#444444" />
                            <TextBlock Text="Select All" Foreground="#333333" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Data Table Grid with Full Vertical & Horizontal Borders -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 1:1 Table Header Row -->
                        <Grid Grid.Row="0" Background="#E8EDF2" BorderBrush="#D0D5DD" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" MinWidth="130" />
                                <ColumnDefinition Width="2.2*" MinWidth="180" />
                                <ColumnDefinition Width="0.7*" MinWidth="65" />
                                <ColumnDefinition Width="1.2*" MinWidth="110" />
                                <ColumnDefinition Width="2.2*" MinWidth="180" />
                                <ColumnDefinition Width="0.9*" MinWidth="80" />
                                <ColumnDefinition Width="1.0*" MinWidth="95" />
                                <ColumnDefinition Width="1.2*" MinWidth="110" />
                                <ColumnDefinition Width="1.2*" MinWidth="110" />
                                <ColumnDefinition Width="1.0*" MinWidth="95" />
                                <ColumnDefinition Width="0.7*" MinWidth="65" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#D0D5DD" BorderThickness="0,0,1,0" Padding="6,6,6,6">
                                <TextBlock Text="Patient Name" Foreground="#333333" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#D0D5DD" BorderThickness="0,0,1,0" Padding="6,6,6,6">
                                <TextBlock Text="Plan Name" Foreground="#333333" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#D0D5DD" BorderThickness="0,0,1,0" Padding="6,6,6,6">
                                <TextBlock Text="Action" Foreground="#333333" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#D0D5DD" BorderThickness="0,0,1,0" Padding="6,6,6,6">
                                <TextBlock Text="Details" Foreground="#333333" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="4" BorderBrush="#D0D5DD" BorderThickness="0,0,1,0" Padding="6,6,6,6">
                                <TextBlock Text="Details" Foreground="#333333" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="5" BorderBrush="#D0D5DD" BorderThickness="0,0,1,0" Padding="6,6,6,6">
                                <TextBlock Text="Comment" Foreground="#333333" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="6" BorderBrush="#D0D5DD" BorderThickness="0,0,1,0" Padding="6,6,6,6">
