<Page
    x:Class="AxioVital.Desktop.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AxioVital.Desktop.Models"
    xmlns:views="using:AxioVital.Desktop.Views"
    mc:Ignorable="d"
    Background="#F4F5F7">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Topmost Nav Bar 1 -->
            <RowDefinition Height="Auto" />
            <!-- 1. Sub Nav Bar 2 -->
            <RowDefinition Height="Auto" />
            <!-- 2. Category Bar 3 -->
            <RowDefinition Height="Auto" />
            <!-- 3. Dark Blue Header Bar 4 -->
            <RowDefinition Height="Auto" />
            <!-- 4. Light Blue Tab Strip Bar 5 -->
            <RowDefinition Height="Auto" />
            <!-- 5. Deep Blue Patient Demographic Banner -->
            <RowDefinition Height="Auto" />
            <!-- 6. Main Content Area (Patient Profile OR Message Center) -->
            <RowDefinition Height="*" />
            <!-- 7. Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. TOP RIBBON OPTIONS BAR ==================== -->
        <Grid x:Name="TopRibbonBarGrid" Grid.Row="0" Background="#F2F3F5" Padding="12,4,12,4" BorderBrush="#D5D9E0" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Home" Foreground="#111111" FontSize="11" FontWeight="Bold" PointerPressed="OnHomeTabPointerPressed" />
                <TextBlock Text="Ledger" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="ambulatory" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Clinical" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Notifications" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Admin" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Help" Foreground="#333333" FontSize="11" FontWeight="Normal" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="#555555" />
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#555555" />
                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="#555555" />
            </StackPanel>
        </Grid>

        <!-- ==================== 1. SUB NAV BAR 2 ==================== -->
        <Grid x:Name="SubNavBarGrid" Grid.Row="1" Background="#FFFFFF" Padding="12,5,12,5" BorderBrush="#D0D4DC" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Message Center Tab Button -->
                <Border x:Name="MessageCenterTabBorder" Padding="0,0,0,3" PointerPressed="OnMessageCenterTabPointerPressed">
                    <TextBlock x:Name="MessageCenterTabText" Text="Message Center" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                </Border>

                <!-- Patient List Tab Button -->
                <Border x:Name="PatientListTabBorder" BorderBrush="#0A658E" BorderThickness="0,0,0,2" Padding="0,0,0,3" PointerPressed="OnPatientListTabPointerPressed">
                    <TextBlock x:Name="PatientListTabText" Text="Patient List" Foreground="#0A658E" FontSize="11" FontWeight="Bold" />
                </Border>

                <TextBlock Text="Physician Handoff" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Care Workflow" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <TextBlock Text="Quality Measures" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <Border x:Name="CustomisedTabBorder" Padding="0,0,0,3" PointerPressed="OnCustomisedTabPointerPressed">
                    <TextBlock x:Name="CustomisedTabText" Text="Customised" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                </Border>
                <TextBlock Text="Reports" Foreground="#111111" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="UpToDate" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                <Border x:Name="OngoingActivitiesTabBorder" Padding="0,0,0,3" PointerPressed="OnOngoingActivitiesTabPointerPressed">
                    <TextBlock x:Name="OngoingActivitiesTabText" Text="Ongoing Activities" Foreground="#333333" FontSize="11" FontWeight="Normal" />
                </Border>
            </StackPanel>

            <FontIcon Grid.Column="1" Glyph="&#xE712;" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== 2. CATEGORY BAR 3 ==================== -->
        <Grid x:Name="CategoryBarGrid" Grid.Row="2" Background="#EEF2F6" Padding="12,4,12,4" BorderBrush="#CBD0D8" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="Dashboard" Foreground="#444444" FontSize="11" />
                <TextBlock Text="Scheduler" Foreground="#0A658E" FontSize="11" FontWeight="Bold" PointerPressed="OnSchedulerTabPointerPressed" />
                <TextBlock Text="Order Sets" Foreground="#111111" FontSize="11" FontWeight="Bold" PointerPressed="OnOrderSetsTabPointerPressed" />
                <TextBlock Text="Care Pathways" Foreground="#444444" FontSize="11" />
                <TextBlock x:Name="LabsCategoryTab" Text="Labs" Foreground="#444444" FontSize="11" PointerPressed="OnLabsTabPointerPressed" />
                <TextBlock Text="Analytics" Foreground="#444444" FontSize="11" />
            </StackPanel>

            <FontIcon Grid.Column="1" Glyph="&#xE712;" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== 3. DARK BLUE HEADER BAR 4 ==================== -->
        <Grid x:Name="DarkHeaderBarGrid" Grid.Row="3" Background="#0A527B" Padding="12,3,12,3" MinHeight="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HeaderTitleText" Grid.Column="0" Text="Patient Profile" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />

            <!-- Quick Tools Right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Background="#021826" CornerRadius="5" Padding="8,2,8,2" Height="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" FontSize="11" VerticalAlignment="Center" />
                        <TextBox PlaceholderText="Search by Patient or Order..." Background="Transparent" Foreground="White" BorderThickness="0" FontSize="11" Width="185" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" PointerPressed="OnFullScreenPointerPressed">
                    <FontIcon Glyph="&#xE740;" FontSize="11" Foreground="White" />
                    <TextBlock Text="Full screen" Foreground="White" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE749;" FontSize="11" Foreground="White" />
                    <TextBlock Text="Print" Foreground="White" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="White" />
                    <TextBlock Text="0 minutes ago" Foreground="White" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ==================== 4. LIGHT BLUE TAB STRIP BAR 5 ==================== -->
        <Grid x:Name="TabStripBarGrid" Grid.Row="4" Background="#BACBD4" Padding="12,3,12,0" MinHeight="30">
            <ListView x:Name="TabStripListView"
                      ItemsSource="{Binding OpenTabs}"
                      SelectionMode="None"
                      CanReorderItems="True"
                      AllowDrop="True"
                      CanDragItems="True"
                      IsItemClickEnabled="True"
                      ItemClick="OnTabStripItemClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="MinHeight" Value="26" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter x:Name="ContentPresenter" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding TabBackground}"
                                CornerRadius="3,3,0,0"
                                Padding="12,5,10,5">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding TextColor}"
                                           FontSize="11"
                                           FontWeight="{Binding TextWeight}"
                                           FontFamily="Segoe UI"
                                           VerticalAlignment="Center" />
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2,0"
                                        Margin="2,0,0,0"
                                        MinHeight="0"
                                        MinWidth="0"
                                        Click="OnTabCloseButtonClick"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding CloseButtonVisibility}">
                                    <TextBlock Text="✕" Foreground="#777777" FontSize="10" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ==================== 5. DEEP BLUE PATIENT DEMOGRAPHIC BANNER ==================== -->
        <Grid x:Name="PatientDemographicBanner" Grid.Row="5" Background="#0A5B86" Padding="12,4,12,4" MinHeight="42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="3.4*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Patient Name & Care Details -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="JOHN DOE" Foreground="White" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Allergies: shellfish" Foreground="#C6DFEE" FontSize="10" Margin="0,1,0,0" />
                <TextBlock Text="Care Team: View Details" Foreground="#72C5FF" FontSize="10" TextDecorations="Underline" Margin="0,1,0,0" />
            </StackPanel>

            <!-- Column 2: DOB & Dose -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="DOB: 3/22/1984" Foreground="White" FontSize="10" />
                <TextBlock Text="Dose Wt: 80.000 kg (04/25/2021)" Foreground="White" FontSize="10" />
                <TextBlock Text="Height: 180 cm (04/25/2021)" Foreground="White" FontSize="10" />
            </StackPanel>

            <!-- Column 3: Admit Info -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Admit: 04/25/2021" Foreground="White" FontSize="10" />
                <TextBlock Text="Loc: 2E - 201 - A" Foreground="White" FontSize="10" />
                <TextBlock Text="MRN: 1000245678" Foreground="White" FontSize="10" />
            </StackPanel>

            <!-- Column 4: Attending Provider -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Attending: AXIO, MD" Foreground="White" FontSize="10" />
                <TextBlock Text="Code: Full Code" Foreground="White" FontSize="10" />
                <TextBlock Text="Isolation: None" Foreground="White" FontSize="10" />
            </StackPanel>

            <!-- Column 5: Patient Summary Metadata -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="MRN: AVX SL A1H4XE" Foreground="White" FontSize="10" />
                <TextBlock Text="Nominee: Mr. Ajin singh" Foreground="White" FontSize="10" />
                <TextBlock Text="Inpatient FIN: 00096526415 [Admit Dt: 10/6/2020 3.14.12 PM CDT]" Foreground="White" FontSize="10" />
            </StackPanel>

            <!-- Column 6: Hamburger Button -->
            <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center" Margin="6,0,0,0" x:Name="PatientActionsMenuButton" Click="OnPatientActionsMenuButtonClick">
                <FontIcon Glyph="&#xE700;" FontSize="16" Foreground="White" />
            </Button>
        </Grid>

        <!-- ==================== 6. MAIN CONTENT AREA (Modular UserControls) ==================== -->
        <Grid Grid.Row="6">
            <views:PatientProfileView x:Name="PatientProfileViewControl" Visibility="Collapsed" />
            <views:PatientListView x:Name="PatientListViewControl" Visibility="Visible" />
            <views:MessageCenterView x:Name="MessageCenterViewControl" Visibility="Collapsed" />
            <views:LabsView x:Name="LabsViewControl" Visibility="Collapsed" />
            <views:SchedulerView x:Name="SchedulerViewControl" Visibility="Collapsed" />
            <views:OngoingActivitiesView x:Name="OngoingActivitiesViewControl" Visibility="Collapsed" />
            <views:CustomisedView x:Name="CustomisedViewControl" Visibility="Collapsed" />
        </Grid>


        <!-- ==================== 7. PERMANENT BOTTOM STATUS BAR / FOOTER ==================== -->
        <Grid x:Name="PermanentFooterBar" Grid.Row="7" Background="#041D2C" Padding="12,4,12,4" MinHeight="24" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Status Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Ready" Foreground="White" FontSize="10" />
                <TextBlock Text="Patient: JOHN DOE ( MRN: 1000245678 )" Foreground="White" FontSize="10" FontWeight="Bold" />
            </StackPanel>

            <!-- Right Status System & User Info -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <TextBlock Text="User: AxioVital Admin" Foreground="White" FontSize="10" />
                <TextBlock Text="AXIOVITAL HEALTHCARE SYSTEM" Foreground="White" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="PROD" Foreground="White" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="FooterDateTimeText" Text="12/08/2026 03:12 AM" Foreground="White" FontSize="10" />
            </StackPanel>
        </Grid>

    </Grid>
</Page>
