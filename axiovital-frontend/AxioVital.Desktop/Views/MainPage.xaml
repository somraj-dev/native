                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="#8B5CF6" ToolTipService.ToolTip="Clinical Documents" />
                                <FontIcon Glyph="&#xEA86;" FontSize="14" Foreground="#EF4444" ToolTipService.ToolTip="Medications" />
                                <FontIcon Glyph="&#xE95E;" FontSize="14" Foreground="#2563EB" ToolTipService.ToolTip="Clinical Diagnostics" />
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#F97316" ToolTipService.ToolTip="Order Sets" />
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#EAB308" ToolTipService.ToolTip="Clinical Folder" />
                                <!-- S badge -->
                                <Border Width="18" Height="18" Background="#16A34A" CornerRadius="2" ToolTipService.ToolTip="Specialty Consults">
                                    <TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <FontIcon Glyph="&#xE8C6;" FontSize="14" Foreground="#EC4899" ToolTipService.ToolTip="Surgery &amp; Procedures" />
                                <!-- R badge -->
                                <Border Width="18" Height="18" Background="#059669" CornerRadius="2" ToolTipService.ToolTip="Radiology &amp; Imaging">
                                    <TextBlock Text="R" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <FontIcon Glyph="&#xE7B3;" FontSize="14" Foreground="#0D9488" ToolTipService.ToolTip="Ophthalmology / Vision" />
                                <!-- Rx badge -->
                                <Border Width="18" Height="18" Background="#10B981" CornerRadius="2" ToolTipService.ToolTip="Pharmacy Orders">
                                    <TextBlock Text="Rx" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="#D946EF" ToolTipService.ToolTip="Inpatient Bed / Ward" />
                                <!-- Dx badge -->
                                <Border Width="18" Height="18" Background="#7C3AED" CornerRadius="2" ToolTipService.ToolTip="Diagnoses">
                                    <TextBlock Text="Dx" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <FontIcon Glyph="&#xE718;" FontSize="14" Foreground="#EF4444" ToolTipService.ToolTip="Pin to Top" />
                                <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="#3B82F6" ToolTipService.ToolTip="Appointments" />
                                <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="#06B6D4" ToolTipService.ToolTip="Immunizations" />
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#22C55E" ToolTipService.ToolTip="Clinical Notes" />
                                <FontIcon Glyph="&#xEA3B;" FontSize="14" Foreground="#6366F1" ToolTipService.ToolTip="Dental / Oral Health" />
                                <FontIcon Glyph="&#xEA8F;" FontSize="14" Foreground="#F59E0B" ToolTipService.ToolTip="Clinical Alerts" />
                                <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="#F43F5E" ToolTipService.ToolTip="Pathology" />
                                <FontIcon Glyph="&#xE890;" FontSize="14" Foreground="#0284C7" ToolTipService.ToolTip="Vital Trends" />
                                <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="#9333EA" ToolTipService.ToolTip="Lab Analytics" />
                                <FontIcon Glyph="&#xE7C1;" FontSize="14" Foreground="#FBBF24" ToolTipService.ToolTip="Flagged Records" />
                                <FontIcon Glyph="&#xE825;" FontSize="14" Foreground="#15803D" ToolTipService.ToolTip="Financial &amp; Billing" />
                                <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="#14B8A6" ToolTipService.ToolTip="Infection Control" />
                                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="#64748B" ToolTipService.ToolTip="Global Axio Network" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Info Notice Banner (Expandable) -->
                    <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="0,0,0,1" Padding="10,4">
                        <StackPanel Spacing="3">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#2563EB" />
                                    <TextBlock Text="Turning on the Assume Wildcards setting will reduce search strength." FontSize="10.5" Foreground="#1E40AF" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,2" CornerRadius="2" Background="Transparent" PointerEntered="OnLinkBorderPointerEntered" PointerExited="OnLinkBorderPointerExited" PointerPressed="OnNoticeBannerExpandPointerPressed" ToolTipService.ToolTip="Expand Wildcard Search Rules">
                                    <FontIcon x:Name="NoticeBannerExpandIcon" Glyph="&#xE740;" FontSize="10" Foreground="#2563EB" />
                                </Border>
                            </Grid>
                            <!-- Expanded Info Panel -->
                            <StackPanel x:Name="NoticeBannerExpandedDetails" Visibility="Collapsed" Margin="18,3,0,2" Spacing="2">
                                <TextBlock Text="• Wildcards (*) automatically append prefix/suffix matching to Name, MRN, and Encounter IDs." FontSize="10" Foreground="#3B82F6" />
                                <TextBlock Text="• Exact matching is disabled when wildcards are active, querying broader clinical records across facilities." FontSize="10" Foreground="#3B82F6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Search Form (Left) & Split Results Tables (Right) -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Search Form Panel -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="12,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="7">
                                    <!-- Search Method -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Search Method" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                        <ComboBox x:Name="PersonSearchMethodCombo" Height="28" SelectedIndex="0" HorizontalAlignment="Stretch" FontSize="11" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <ComboBoxItem Content="Name (First/Last)" />
                                            <ComboBoxItem Content="MRN" />
                                            <ComboBoxItem Content="Encounter ID" />
                                            <ComboBoxItem Content="Birth Date" />
                                            <ComboBoxItem Content="Any Phone Number" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Last Name -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Last Name" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBox x:Name="PersonSearchLastNameBox" Height="26" MinHeight="26" Padding="6,2" VerticalContentAlignment="Center" FontSize="11" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" KeyDown="OnPersonSearchBoxKeyDown" />
                                    </StackPanel>

                                    <!-- First Name -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="First Name" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBox x:Name="PersonSearchFirstNameBox" Height="26" MinHeight="26" Padding="6,2" VerticalContentAlignment="Center" FontSize="11" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" KeyDown="OnPersonSearchBoxKeyDown" />
                                    </StackPanel>

                                    <!-- Birth Date -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Birth Date" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PersonSearchDobBox" Grid.Column="0" PlaceholderText="DD/MM/YYYY" Height="26" MinHeight="26" Padding="6,2" VerticalContentAlignment="Center" FontSize="11" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" KeyDown="OnPersonSearchBoxKeyDown" />
                                            <Button Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Height="26" Width="28" Padding="0" Margin="3,0,0,0" CornerRadius="2">
                                                <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="#0A658E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Any Phone Number -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Any Phone Number" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBox x:Name="PersonSearchPhoneBox" Height="26" MinHeight="26" Padding="6,2" VerticalContentAlignment="Center" FontSize="11" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" KeyDown="OnPersonSearchBoxKeyDown" />
                                    </StackPanel>

                                    <!-- Encounter Identifiers -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Encounter Identifiers" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBox x:Name="PersonSearchEncounterBox" Height="26" MinHeight="26" Padding="6,2" VerticalContentAlignment="Center" FontSize="11" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" KeyDown="OnPersonSearchBoxKeyDown" />
                                    </StackPanel>

                                    <!-- Search & Clear Action Buttons -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <Button Width="85" Height="26" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Click="OnPersonSearchButtonClick">
                                            <TextBlock Text="Search..." Foreground="#0F172A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Width="60" Height="26" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Click="OnPersonSearchClearClick">
                                            <TextBlock Text="Clear" Foreground="#0F172A" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Results Panel -->
                        <Grid Grid.Column="1" Padding="10,8">
                            <Grid.RowDefinitions>
                                <!-- Person Table Row -->
                                <RowDefinition Height="*" />
                                <!-- Encounter Table Row -->
                                <RowDefinition Height="165" />
                            </Grid.RowDefinitions>

                            <!-- 1. Person Table Area -->
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Person Header with persistent styling on hover -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Person" FontSize="11" FontWeight="Bold" Foreground="#0A658E" VerticalAlignment="Center" />
                                        <Border Padding="6,2" CornerRadius="2" Background="Transparent" PointerEntered="OnLinkBorderPointerEntered" PointerExited="OnLinkBorderPointerExited">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontSize="11" FontWeight="Bold" Foreground="#0A658E" />
                                                <TextBlock Text="Add" FontSize="10.5" FontWeight="SemiBold" Foreground="#0A658E" />
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="2" Background="Transparent" PointerEntered="OnLinkBorderPointerEntered" PointerExited="OnLinkBorderPointerExited">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE721;" FontSize="11" Foreground="#0A658E" />
                                                <TextBlock Text="Preview" FontSize="10.5" FontWeight="SemiBold" Foreground="#0A658E" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,2" CornerRadius="2" Background="Transparent" PointerEntered="OnLinkBorderPointerEntered" PointerExited="OnLinkBorderPointerExited">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#0A658E" />
                                            <TextBlock Text="Search Settings" FontSize="10.5" FontWeight="SemiBold" Foreground="#0A658E" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Person Table Grid -->
                                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Table Header -->
                                        <Grid Grid.Row="0" Background="#F1F5F9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="35" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Name" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="MRN" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Date of Birth" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="3" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Sex" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="4" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Age" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="5" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Account Number" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="6" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,2"><TextBlock Text="Address" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                        </Grid>

                                        <!-- Table Rows List -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <TextBlock x:Name="PersonSearchEmptyPromptText" Text="No search results. Enter parameters and click Search..." FontStyle="Italic" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,35,0,0" />
                                                <StackPanel x:Name="PersonSearchResultsPanel" />
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 2. Encounter Table Area -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Encounter Header -->
                                <TextBlock Grid.Row="0" Text="Encounter" FontSize="11" FontWeight="Bold" Foreground="#0A658E" Margin="0,0,0,3" />

                                <!-- Encounter Table Grid -->
                                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Encounter Column Headers -->
                                        <Grid Grid.Row="0" Background="#F1F5F9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Encounter" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Facility" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Encounter Type" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="3" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Date of Service" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="4" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Resource" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="5" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1" Padding="4,2"><TextBlock Text="Guarantor" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                            <Border Grid.Column="6" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,2"><TextBlock Text="Discharge Date" Foreground="#334155" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Border>
                                        </Grid>

                                        <!-- Encounter Rows List -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <TextBlock x:Name="EncounterSearchEmptyPromptText" Text="Select a person to view encounters." FontStyle="Italic" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0" />
                                                <StackPanel x:Name="EncounterSearchResultsPanel" />
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 4. Dialog Bottom Action Footer -->
                    <Border Grid.Row="4" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10,4">
                        <Grid>
                            <CheckBox Content="Assume Wildcards" IsChecked="True" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="PersonSearchSelectButton" Content="Select" Width="70" Height="25" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" FontSize="11" Click="OnPersonSearchSelectClick" />
                                <Button Content="Cancel" Width="70" Height="25" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" FontSize="11" Click="OnPersonSearchCancelClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Minimized Floating Person Search Bar (Shown when minimized) -->
            <Border x:Name="PersonSearchMinimizedBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,28" Background="#F59E0B" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="10,6" Visibility="Collapsed" PointerPressed="OnPersonSearchRestoreFromMinClick" RequestedTheme="Light">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE716;" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Person Search (F10)" Foreground="#1E293B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Padding="4,1" Background="#FDE68A" CornerRadius="2" PointerPressed="OnPersonSearchRestoreFromMinClick">
                        <TextBlock Text="🗖 Restore" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B" />
                    </Border>
                    <Border Padding="4,1" Background="Transparent" PointerPressed="OnPersonSearchCancelClick">
                        <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#1E293B" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 10. PATIENT DETAILS MODAL POPUP (F9) ==================== -->
        <Grid x:Name="PatientDetailsPopupOverlay" Grid.Row="0" Grid.RowSpan="8" Background="#66000000" Visibility="Collapsed" PointerPressed="OnPatientDetailsPopupBackdropPointerPressed">
            <views:NewPatientView x:Name="PatientDetailsPopupControl" HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnPatientDetailsDialogPointerPressed" />
        </Grid>

        <!-- ==================== 11. BED TRANSFER MODAL POPUP ==================== -->
        <Grid x:Name="BedTransferPopupOverlay" Grid.Row="0" Grid.RowSpan="8" Background="#66000000" Visibility="Collapsed" PointerPressed="OnBedTransferPopupBackdropPointerPressed">
            <views:BedTransferView x:Name="BedTransferPopupControl" HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnBedTransferDialogPointerPressed" />
        </Grid>

        <!-- ==================== 12. PENDING TRANSFER / FACILITY TRANSFER WARNING MODAL ==================== -->
        <Grid x:Name="PendingTransferWarningPopupOverlay" Grid.Row="0" Grid.RowSpan="8" Background="#66000000" Visibility="Collapsed" PointerPressed="OnPendingTransferWarningBackdropPointerPressed">
            <views:PendingTransferWarningDialog x:Name="PendingTransferWarningPopupControl" HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnPendingTransferWarningDialogPointerPressed" />
        </Grid>

        <!-- ==================== 13. VIEW ENCOUNTER / MEDICAL RECORD REQUEST MODAL ==================== -->
        <Grid x:Name="ViewEncounterPopupOverlay" Grid.Row="0" Grid.RowSpan="8" Background="#66000000" Visibility="Collapsed" PointerPressed="OnViewEncounterBackdropPointerPressed">
            <views:ViewEncounterDialog x:Name="ViewEncounterPopupControl" HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnViewEncounterDialogPointerPressed" />
        </Grid>

        <!-- ==================== 14. DEVELOPER PANEL FULL SCREEN VIEW ==================== -->
        <Grid x:Name="DeveloperPanelOverlay" Grid.Row="0" Grid.RowSpan="8" Background="#FFFFFF" Visibility="Collapsed">
            <views:DeveloperPanelView x:Name="DeveloperPanelControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

    </Grid>
</Page>
