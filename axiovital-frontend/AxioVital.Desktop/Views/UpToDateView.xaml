<UserControl
    x:Class="AxioVital.Desktop.Views.UpToDateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <!-- 1. Top Controls Bar (Flowsheet, Level, View Mode Radios) -->
            <RowDefinition Height="Auto" />
            <!-- 2. Blue Sub-Banner with Nav Arrows (03 March 2008 - 30 March 2014) -->
            <RowDefinition Height="Auto" />
            <!-- 3. Main Split View: Left Navigator + Right Matrix Table -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP CONTROLS TOOLBAR ==================== -->
        <Grid Grid.Row="0" Background="#F0F4F8" Padding="12,4,12,4" BorderBrush="#CBD7DF" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Controls: Flowsheet & Level Dropdowns -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Flowsheet:" Foreground="#222222" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                
                <!-- Flowsheet Dropdown Box -->
                <Border Background="#FFFFFF" BorderBrush="#8FA3B5" BorderThickness="1" CornerRadius="2" Height="28" Width="170" Padding="7,0,6,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="Clinical Event View" Foreground="#111111" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock Text="▾" Foreground="#445566" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- [...] Action Button -->
                <Border Background="#FFFFFF" BorderBrush="#8FA3B5" BorderThickness="1" CornerRadius="2" Height="28" Width="26" VerticalAlignment="Center">
                    <TextBlock Text="···" Foreground="#333333" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>

                <!-- Level Label -->
                <TextBlock Text="Level:" Foreground="#222222" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />

                <!-- Level Dropdown Box -->
                <Border Background="#FFFFFF" BorderBrush="#8FA3B5" BorderThickness="1" CornerRadius="2" Height="28" Width="150" Padding="7,0,6,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="Clinical Event View" Foreground="#111111" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock Text="▾" Foreground="#445566" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right Controls: View Mode Radios -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- Table (Selected) -->
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" PointerPressed="OnTableRadioPressed">
                    <Grid Width="13" Height="13" VerticalAlignment="Center">
                        <Ellipse x:Name="TableRadioRing" Width="13" Height="13" Stroke="#0B4466" StrokeThickness="1.5" Fill="White" />
                        <Ellipse x:Name="TableRadioDot" Width="6.5" Height="6.5" Fill="#0B4466" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible" />
                    </Grid>
                    <TextBlock x:Name="TableRadioText" Text="Table" FontSize="12.5" Foreground="#0B4466" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Group -->
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" PointerPressed="OnGroupRadioPressed">
                    <Grid Width="13" Height="13" VerticalAlignment="Center">
                        <Ellipse x:Name="GroupRadioRing" Width="13" Height="13" Stroke="#777777" StrokeThickness="1.2" Fill="White" />
                        <Ellipse x:Name="GroupRadioDot" Width="6.5" Height="6.5" Fill="#0B4466" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="GroupRadioText" Text="Group" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" />
                </StackPanel>

                <!-- List -->
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" PointerPressed="OnListRadioPressed">
                    <Grid Width="13" Height="13" VerticalAlignment="Center">
                        <Ellipse x:Name="ListRadioRing" Width="13" Height="13" Stroke="#777777" StrokeThickness="1.2" Fill="White" />
                        <Ellipse x:Name="ListRadioDot" Width="6.5" Height="6.5" Fill="#0B4466" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="ListRadioText" Text="List" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ==================== 2. SUB-BANNER BAR WITH NAV ARROWS ==================== -->
        <Grid Grid.Row="1" Background="#7596A9" Height="23" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Arrows -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="◀" Foreground="White" FontSize="11.5" VerticalAlignment="Center" />
                <TextBlock Text="▶" Foreground="White" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Center Clinical Range Title -->
            <TextBlock Grid.Column="1" 
                       Text="03 March 2008 00:17 EST - 30 March 2014 14:14 EDT (Clinical Range)" 
                       Foreground="White" 
                       FontSize="12.5" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />

            <!-- Right Navigation Arrows -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="◀" Foreground="White" FontSize="11.5" VerticalAlignment="Center" />
                <TextBlock Text="▶" Foreground="White" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ==================== 3. MAIN SPLIT CONTENT ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Navigator Sidebar -->
                <ColumnDefinition Width="190" />
                <!-- Right Matrix Grid -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigator Pane -->
            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD7DF" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Navigator Header -->
                    <Border Grid.Row="0" Background="#B8C8D4" BorderBrush="#CBD7DF" BorderThickness="0,0,0,1" Padding="8,5">
                        <Grid>
                            <TextBlock Text="Navigator" Foreground="#112233" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBlock Text="✕" Foreground="#445566" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Checklist -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,6,8">
                        <StackPanel Spacing="7">
                            <!-- Checked: Clinical Event Notification -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="13" Height="13" Background="#0A658E" CornerRadius="2">
                                    <TextBlock Text="✓" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                                <TextBlock Text="Clinical Event Notification" FontSize="11.5" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Checked: Adverse Reaction Event -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="13" Height="13" Background="#0A658E" CornerRadius="2">
                                    <TextBlock Text="✓" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                                <TextBlock Text="Adverse Reaction Event" FontSize="11.5" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Checked: AMA Guidelines Event -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="13" Height="13" Background="#0A658E" CornerRadius="2">
                                    <TextBlock Text="✓" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                                <TextBlock Text="AMA Guidelines Event" FontSize="11.5" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Checked: Lab/Rad Details Event -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="13" Height="13" Background="#0A658E" CornerRadius="2">
                                    <TextBlock Text="✓" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                                <TextBlock Text="Lab/Rad Details Event" FontSize="11.5" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Checked: Clinician Notification -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="13" Height="13" Background="#0A658E" CornerRadius="2">
                                    <TextBlock Text="✓" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                                <TextBlock Text="Clinician Notification" FontSize="11.5" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Results Flowsheet Matrix Table -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid Background="#FFFFFF" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Category / Parameter Name -->
                        <ColumnDefinition Width="220" />
                        <!-- 12 Date Columns with Star Width -->
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                        <ColumnDefinition Width="*" MinWidth="95" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <!-- 0: Column Headers (Dates) -->
                        <RowDefinition Height="30" />
                        <!-- 1: Section: Clinical Event Notification -->
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <!-- 11: Section: Adverse Reaction Event -->
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <!-- 18: Section: AMA Guidelines Event -->
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <!-- 20: Section: Lab/Rad Details Event -->
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <!-- 22: Section: Clinician Notification -->
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <!-- ==================== 0. COLUMN HEADERS ==================== -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="8,4">
                        <TextBlock Text="Clinical Event View" Foreground="#334455" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="11/15/2012" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:00 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/28/2013" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="15:53 EDT" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="11/18/2013" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="14:04 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="01/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:24 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="5" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="11:50 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="6" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:12 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="7" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:15 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="8" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:26 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="9" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:38 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="10" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:41 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="11" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,1,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:46 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="12" Background="#EDF3F7" BorderBrush="#CBD7DF" BorderThickness="0,0,0,1" Padding="4,2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="03/03/2014" Foreground="#334455" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="12:48 EST" Foreground="#556677" FontSize="8.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- ==================== 1. SECTION: CLINICAL EVENT NOTIFICATION ==================== -->
                    <Border Grid.Row="1" Grid.ColumnSpan="13" Background="#D9E5EE" BorderBrush="#CBD7DF" BorderThickness="0,0,0,1" Padding="8,2">
                        <TextBlock Text="Clinical Event Notification" Foreground="#0A4C6D" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>

                    <!-- Row 2: Notified Date/Time - Contact 1 -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="8,3"><TextBlock Text="Notified Date/Time - Contact 1" Foreground="#222222" FontSize="11.5" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="* 11/15/2012 12:00" Foreground="#1A56DB" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="2" Grid.Column="3" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="2" Grid.Column="4" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="2" Grid.Column="5" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="2" Grid.Column="6" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="03/03/2014" Foreground="#1A56DB" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="7" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="03/03/2014" Foreground="#1A56DB" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="8" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="03/03/2014" Foreground="#1A56DB" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="9" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="03/03/2014" Foreground="#1A56DB" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="10" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="03/03/2014" Foreground="#1A56DB" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="11" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="03/03/2014" Foreground="#1A56DB" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="2" Grid.Column="12" BorderBrush="#E5ECF0" BorderThickness="0,0,0,1" Padding="4,3"><TextBlock Text="03/03/2014" Foreground="#1A56DB" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>

                    <!-- Row 3: Notified - Contact 2 -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="8,3"><TextBlock Text="Notified - Contact 2" Foreground="#222222" FontSize="11.5" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="3" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="4" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="5" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="* Manager/" Foreground="#1A56DB" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="3" Grid.Column="6" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="7" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="8" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="9" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="10" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="11" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="3" Grid.Column="12" BorderBrush="#E5ECF0" BorderThickness="0,0,0,1" Padding="4,3" />

                    <!-- Row 4: Notification Detail -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="8,3"><TextBlock Text="Notification Detail" Foreground="#222222" FontSize="11.5" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="test" Foreground="#222222" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="4" Grid.Column="2" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="4" Grid.Column="3" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3"><TextBlock Text="(s) This was" Foreground="#222222" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border Grid.Row="4" Grid.Column="4" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
                    <Border Grid.Row="4" Grid.Column="5" BorderBrush="#E5ECF0" BorderThickness="0,0,1,1" Padding="4,3" />
