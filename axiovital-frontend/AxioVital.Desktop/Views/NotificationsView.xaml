<UserControl
    x:Class="AxioVital.Desktop.Views.NotificationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar: Inbox Summary -->
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320" />
            <!-- Splitter Border -->
            <ColumnDefinition Width="2" />
            <!-- Right Data / Reminders Pane -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


            <!-- ==================== LEFT SIDEBAR: INBOX SUMMARY ==================== -->
            <Grid Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <!-- Sidebar Header -->
                    <RowDefinition Height="26" />
                    <!-- Tabs (Inbox, Proxies, Pools) -->
                    <RowDefinition Height="26" />
                    <!-- Display Filter Row -->
                    <RowDefinition Height="Auto" />
                    <!-- Red Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Category Tree -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Sidebar Header Bar -->
                <Grid Grid.Row="0" Background="#203A4E" Padding="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Inbox Summa..." 
                               Foreground="#FFFFFF" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" />
                    <!-- Pin Icon -->
                    <Button Grid.Column="1" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2" 
                            MinHeight="0" 
                            MinWidth="0">
                        <FontIcon Glyph="&#xE718;" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- Row 1: Sub-Tabs (Inbox, Proxies, Pools) -->
                <Grid Grid.Row="1" Background="#E2E8F0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Inbox Tab (Active) -->
                    <Border x:Name="TabInboxBorder" Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" PointerPressed="OnSidebarTabInboxPressed">
                        <TextBlock x:Name="TabInboxText" Text="Inbox" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Proxies Tab -->
                    <Border x:Name="TabProxiesBorder" Grid.Column="1" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" PointerPressed="OnSidebarTabProxiesPressed">
                        <TextBlock x:Name="TabProxiesText" Text="Proxies" FontSize="11" FontWeight="Normal" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Pools Tab -->
                    <Border x:Name="TabPoolsBorder" Grid.Column="2" Background="#E2E8F0" PointerPressed="OnSidebarTabPoolsPressed">
                        <TextBlock x:Name="TabPoolsText" Text="Pools" FontSize="11" FontWeight="Normal" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Row 2: Display Filter Dropdown & Custom Button -->
                <Grid Grid.Row="2" Background="#FFFFFF" Padding="8,6,8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Display:" FontSize="10.5" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0" />
                    
                    <ComboBox x:Name="DisplayRangeCombo" 
                              Grid.Column="1" 
                              SelectedIndex="2" 
                              FontSize="10" 
                              MinHeight="22" 
                              Height="22" 
                              Padding="4,1" 
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnDisplayRangeChanged">
                        <ComboBoxItem Content="Last 30 Days" FontSize="10" />
                        <ComboBoxItem Content="Last 60 Days" FontSize="10" />
                        <ComboBoxItem Content="Last 90 Days" FontSize="10" />
                        <ComboBoxItem Content="Last 180 Days" FontSize="10" />
                        <ComboBoxItem Content="All Dates" FontSize="10" />
                    </ComboBox>

                    <Button x:Name="FilterDetailsBtn" 
                            Grid.Column="2" 
                            Content="..." 
                            FontSize="10" 
                            FontWeight="Bold" 
                            Padding="4,0" 
                            MinHeight="22" 
                            Height="22" 
                            MinWidth="22" 
                            Margin="4,0,0,0" 
                            Background="#F1F5F9" 
                            BorderBrush="#CBD5E1" 
                            BorderThickness="1"
                            Click="OnFilterDetailsClicked" />
                </Grid>

                <!-- Row 3: Red Notice Header -->
                <Grid Grid.Row="3" Background="#FFFFFF" Padding="8,4,8,2">
                    <TextBlock x:Name="SidebarNoticeText" 
                               Text="General Notifications (0/1)" 
                               Foreground="#C00000" 
                               FontSize="10" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Row 4: Collapsible Category Tree -->
                <ScrollViewer Grid.Row="4" Background="#FFFFFF" VerticalScrollBarVisibility="Auto" Padding="2,2,2,8">
                    <StackPanel Spacing="1">

                        <!-- SECTION 1: INBOX ITEMS (10) -->
                        <Border Background="#DCE7F0" BorderBrush="#BCCCDC" BorderThickness="0,1,0,1" Padding="4,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="⊟" FontSize="10" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                <TextBlock Text="Inbox Items (10)" FontSize="10.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Results (0/1) -->
                        <StackPanel Margin="10,1,0,1">
                            <Border x:Name="TreeResultsBorder" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Results">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="⊟" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="Results (0/1)" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- Sub item: Abnormal (0/1) -->
                            <Border x:Name="TreeAbnormalBorder" Margin="14,1,0,1" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Abnormal">
                                <TextBlock Text="Abnormal (0/1)" FontSize="10" Foreground="#1E293B" />
                            </Border>
                        </StackPanel>

                        <!-- Orders (3/3) -->
                        <StackPanel Margin="10,1,0,1">
                            <Border x:Name="TreeOrdersBorder" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Orders">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="⊟" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="Orders (3/3)" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- Sub items -->
                            <Border x:Name="TreeCosignBorder" Margin="14,1,0,1" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Cosign Orders">
                                <TextBlock Text="Cosign Orders (3/3)" FontSize="10" Foreground="#1E293B" />
                            </Border>
                            <Border x:Name="TreeResultsFyiBorder" Margin="14,1,0,1" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Results FYI">
                                <TextBlock Text="Results FYI" FontSize="10" Foreground="#1E293B" />
                            </Border>
                        </StackPanel>

                        <!-- Documents (5/6) -->
                        <StackPanel Margin="10,1,0,1">
                            <Border x:Name="TreeDocsBorder" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Documents">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="⊟" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="Documents (5/6)" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- Sub items -->
                            <Border x:Name="TreeSignBorder" Margin="14,1,0,1" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Sign">
                                <TextBlock Text="Sign (1/1)" FontSize="10" Foreground="#1E293B" />
                            </Border>
                            <Border x:Name="TreeReviewBorder" Margin="14,1,0,1" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Review">
                                <TextBlock Text="Review (4/5)" FontSize="10" Foreground="#1E293B" />
                            </Border>
                        </StackPanel>

                        <!-- Notifications (2/5) -->
                        <StackPanel Margin="10,1,0,1">
                            <Border x:Name="TreeNotificationsBorder" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Notifications">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="⊟" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="Notifications (2/5)" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="TreeGeneralNotificationBorder" Margin="14,1,0,1" Padding="4,2" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="General Notifications">
                                <TextBlock Text="General Notifications (2/5)" FontSize="10" Foreground="#1E293B" />
                            </Border>
                        </StackPanel>

                        <!-- SECTION 2: WORK ITEMS (5) -->
                        <Border Background="#DCE7F0" BorderBrush="#BCCCDC" BorderThickness="0,1,0,1" Padding="4,3" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="⊟" FontSize="10" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                <TextBlock Text="Work Items (5)" FontSize="10.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="10,1,0,0" Spacing="1">
                            <!-- Saved Documents (4/4) -->
                            <Border x:Name="TreeSavedDocsBorder" Padding="4,2.5" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Saved Documents">
                                <TextBlock x:Name="TreeSavedDocsText" Text="Saved Documents (4/4)" FontSize="10" Foreground="#1E293B" />
                            </Border>

                            <!-- Deficient Documents -->
                            <Border x:Name="TreeDeficientDocsBorder" Padding="4,2.5" Background="Transparent" PointerPressed="OnTreeCategoryPressed" Tag="Deficient Documents">
                                <TextBlock x:Name="TreeDeficientDocsText" Text="Deficient Documents" FontSize="10" Foreground="#1E293B" />
                            </Border>

                            <!-- Reminders (1/4) - HIGHLIGHTED AS IN SCREENSHOT -->
                            <Border x:Name="TreeRemindersBorder" Padding="6,3" Background="#0078D7" CornerRadius="1" PointerPressed="OnTreeCategoryPressed" Tag="Reminders">
                                <TextBlock x:Name="TreeRemindersText" Text="Reminders (1/4)" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Column 1: Vertical Divider -->
            <Rectangle Grid.Column="1" Fill="#CBD5E1" />

            <!-- ==================== RIGHT CONTENT: REMINDERS TAB & WORK AREA ==================== -->
            <Grid Grid.Column="2" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <!-- 0. Tab Header Bar (Reminders X) -->
                    <RowDefinition Height="26" />
                    <!-- 1. Action Toolbar -->
                    <RowDefinition Height="30" />
                    <!-- 2. Data Grid (Reminders Table) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Content Tab Strip -->
                <Grid Grid.Row="0" Background="#E8EEF5" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFFFFF" 
                                BorderBrush="#CBD5E1" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="2,2,0,0" 
                                Padding="12,3,10,3" 
                                Margin="4,2,0,0"
                                VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock x:Name="ActiveTabTitleText" Text="Reminders" FontSize="11" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <Button Background="Transparent" BorderThickness="0" Padding="2" MinHeight="0" MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock Text="✕" FontSize="9" Foreground="#64748B" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Action Toolbar -->
                <Grid Grid.Row="1" Background="#F4F6F9" Padding="8,2,8,2" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                            <!-- Communicate Dropdown -->
                            <Button x:Name="CommunicateBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" Click="OnCommunicateClicked">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE715;" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center" />
                                    <TextBlock Text="Communicate" FontSize="10.5" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="#64748B" VerticalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <Border Background="White" Width="180" Padding="4">
                                            <StackPanel Spacing="2">
                                                <Button Content="New Notification" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="11" Click="OnNewNotificationClicked" />
                                                <Button Content="Send Notification" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="11" Click="OnSendNotificationClicked" />
                                                <Button Content="Send Reminder" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="11" Click="OnSendReminderClicked" />
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Open (Disabled) -->
                            <Button x:Name="OpenBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE838;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="Open" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Reply (Disabled) -->
                            <Button x:Name="ReplyBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7A4;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="Reply" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Reply All (Disabled) -->
                            <Button x:Name="ReplyAllBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F2;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="Reply All" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Redirect (Disabled) -->
                            <Button x:Name="RedirectBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72A;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="Redirect" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Reschedule (Disabled) -->
                            <Button x:Name="RescheduleBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="Reschedule" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Complete (Disabled) -->
                            <Button x:Name="CompleteBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="Complete" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Notification Journal -->
                            <Button x:Name="NotificationJournalBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" Click="OnNotificationJournalClicked">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center" />
                                    <TextBlock Text="Notification Journal" FontSize="10.5" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Separator -->
                            <Rectangle Width="1" Height="14" Fill="#CBD5E1" VerticalAlignment="Center" />

                            <!-- Select Patient (Disabled) -->
                            <Button x:Name="SelectPatientBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="Select Patient" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Separator -->
                            <Rectangle Width="1" Height="14" Fill="#CBD5E1" VerticalAlignment="Center" />

                            <!-- Select All -->
                            <Button x:Name="SelectAllBtn" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" MinWidth="0" Click="OnSelectAllClicked">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B3;" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center" />
                                    <TextBlock Text="Select All" FontSize="10.5" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Row 2: Data Grid / Reminders Table -->
                <Grid Grid.Row="2" Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <!-- Table Header -->
                        <RowDefinition Height="24" />
                        <!-- Table Body Items -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header Row -->
                    <Grid Grid.Row="0" Background="#E8ECEF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 0. Assigned -->
                        <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <TextBlock Text="Assigned" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 1. Create Date with sort indicator -->
                        <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <Grid>
                                <TextBlock Text="Create Da..." FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                                <TextBlock Text="▽" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. Due Date -->
                        <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <TextBlock Text="Due Date" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 3. From -->
                        <Border Grid.Column="3" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <TextBlock Text="From" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 4. Patient Name -->
                        <Border Grid.Column="4" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <TextBlock Text="Patient Name" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 5. Priority (P..) -->
                        <Border Grid.Column="5" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="4,2">
                            <TextBlock Text="P.." FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 6. Provider -->
                        <Border Grid.Column="6" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <TextBlock Text="Provider" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 7. Show Up Date -->
                        <Border Grid.Column="7" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <TextBlock Text="Show Up Date" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 8. Status -->
                        <Border Grid.Column="8" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="6,2">
                            <TextBlock Text="Status" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>

                        <!-- 9. Subject -->
                        <Border Grid.Column="9" Padding="6,2">
                            <TextBlock Text="Subject" FontSize="10" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Table Rows Container -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NotificationRowsContainer">

                            <!-- ==================== ROW 1 (SELECTED: Dotted Border / Cyan-Blue Tint / Red Status & Subject) ==================== -->
                            <Border x:Name="Row1Border" 
                                    Background="#E5F1FB" 
                                    BorderBrush="#0078D7" 
                                    BorderThickness="1" 
                                    Padding="0" 
                                    PointerPressed="OnRowPointerPressed" 
                                    Tag="1">
                                <Grid Height="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 0. Assigned -->
                                    <TextBlock Grid.Column="0" Text="" FontSize="10" VerticalAlignment="Center" Margin="6,0" />

                                    <!-- 1. Create Date -->
                                    <TextBlock Grid.Column="1" Text="26-May-2020 10:45 AM" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />

                                    <!-- 2. Due Date -->
                                    <TextBlock Grid.Column="2" Text="26-May-2020 11:00 AM" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />

                                    <!-- 3. From -->
                                    <TextBlock Grid.Column="3" Text="TestUser, General (MD)" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />

                                    <!-- 4. Patient Name -->
