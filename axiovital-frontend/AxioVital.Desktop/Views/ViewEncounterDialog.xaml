<UserControl
    x:Class="AxioVital.Desktop.Views.ViewEncounterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <!-- Outer Dialog Window Container matching Classic Medical Record Request -->
    <Border Width="650"
            Background="#FFFFFF"
            BorderBrush="#1B5288"
            BorderThickness="1"
            CornerRadius="2">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Title Bar -->
                <RowDefinition Height="30" />
                <!-- 1. Form Content Area -->
                <RowDefinition Height="*" />
                <!-- 2. Bottom Beige Bar -->
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ==================== 0. TITLE BAR ==================== -->
            <Border Grid.Row="0" Background="#1D5288" CornerRadius="1,1,0,0">
                <Grid Padding="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="13" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               x:Name="DialogTitleText"
                               Text="Medical Record Request - PATIENT ENCOUNTER DEMO"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center" />

                    <!-- Red Close Button ✕ -->
                    <Button Grid.Column="2"
                            Width="26"
                            Height="18"
                            Padding="0"
                            Margin="0"
                            MinHeight="0"
                            MinWidth="0"
                            Background="#D32F2F"
                            BorderThickness="0"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Click="OnCloseClicked">
                        <TextBlock Text="✕"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== 1. FORM CONTENT ==================== -->
            <StackPanel Grid.Row="1" Padding="18,14,18,12" Spacing="10">

                <!-- Top Row: Event Status, Template, Purpose -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Event Status -->
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Event Status" FontSize="10.5" Foreground="#334155" />
                        <ComboBox x:Name="EventStatusCombo" SelectedIndex="0" Height="24" FontSize="11" HorizontalAlignment="Stretch" Padding="6,2">
                            <ComboBoxItem Content="Verified and Pending" />
                            <ComboBoxItem Content="Completed" />
                            <ComboBoxItem Content="In Progress" />
                            <ComboBoxItem Content="Draft" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Template -->
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="Template" FontSize="10.5" Foreground="#334155" />
                        <ComboBox x:Name="TemplateCombo" SelectedIndex="0" Height="24" FontSize="11" HorizontalAlignment="Stretch" Padding="6,2">
                            <ComboBoxItem Content="Inpatient/General Transfer Template" />
                            <ComboBoxItem Content="Clinical Summary Template" />
                            <ComboBoxItem Content="Discharge Summary Template" />
                            <ComboBoxItem Content="Emergency Encounter Template" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Purpose -->
                    <StackPanel Grid.Column="4" Spacing="3">
                        <TextBlock Text="Purpose" FontSize="10.5" Foreground="#334155" />
                        <ComboBox x:Name="PurposeCombo" SelectedIndex="0" Height="24" FontSize="11" HorizontalAlignment="Stretch" Padding="6,2">
                            <ComboBoxItem Content="Patient Transfer" />
                            <ComboBoxItem Content="Continuity of Care" />
                            <ComboBoxItem Content="Legal / Compliance" />
                            <ComboBoxItem Content="Insurance Audit" />
                            <ComboBoxItem Content="Personal Request" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Middle Row: Date Range (Left) & Destination / Comment (Right) -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Date Range GroupBox -->
                    <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="10,12" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <Border Background="White" HorizontalAlignment="Left" Padding="4,0" Margin="0,-20,0,2">
                                <TextBlock Text="Date Range" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                            </Border>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="From:" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="DateRangeFromBox" Grid.Column="1" Text="09-Sep-2023" Height="24" FontSize="11" VerticalContentAlignment="Center" Padding="6,2" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Destination and Comment -->
                    <StackPanel Grid.Column="2" Spacing="6">
                        <!-- Destination -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Destination" FontSize="10.5" Foreground="#334155" />
                            <TextBox x:Name="DestinationBox" Text="VGH Transplant Clinic" Height="24" FontSize="11" VerticalContentAlignment="Center" Padding="6,2" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                        </StackPanel>

                        <!-- Comment -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Comment" FontSize="10.5" Foreground="#334155" />
                            <TextBox x:Name="CommentBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" Padding="6,4" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons: Preview (Left) and Send (Right) -->
                <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PreviewButton"
                            Grid.Column="0"
                            Content="Preview"
                            Width="85"
                            Height="25"
                            Background="#FFFFFF"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="2"
                            FontSize="11"
                            Foreground="#0F172A"
                            HorizontalAlignment="Center"
                            Click="OnPreviewClicked" />

                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="Send"
                            Width="85"
                            Height="25"
                            Background="#FFFFFF"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="2"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            HorizontalAlignment="Center"
                            Click="OnSendClicked" />
                </Grid>

            </StackPanel>

            <!-- ==================== 2. BOTTOM BEIGE STATUS BAR ==================== -->
            <Border Grid.Row="2" Background="#EFECE1" BorderBrush="#DCD8CB" BorderThickness="0,1,0,0" CornerRadius="0,0,1,1" />
        </Grid>
    </Border>
</UserControl>
