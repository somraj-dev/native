<UserControl
    x:Class="AxioVital.Desktop.Views.HistoriesChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Arial, Segoe UI, sans-serif"
    RequestedTheme="Light"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Main Container (Full Page Engagement) -->
    <Grid Background="#FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" Margin="20,16,20,36" Spacing="10">

                <!-- ==================== 1. TOP HEADER & CHARTS ROW (FULL WIDTH) ==================== -->
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <!-- Controls: 210px -->
                        <ColumnDefinition Width="210" />
                        <!-- Chart 1: Daily with 7-Day Moving Average (Wide Stretch) -->
                        <ColumnDefinition Width="1.2*" MinWidth="320" />
                        <!-- Chart 2: Weekly Average (Wide Stretch) -->
                        <ColumnDefinition Width="1*" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Controls -->
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Top" Margin="0,0,16,0">
                        <TextBlock Text="Calendar Chart" FontSize="20" FontWeight="Bold" Foreground="#000000" FontFamily="Arial, Segoe UI" Margin="0,0,0,4" />

                        <!-- Data Set Box -->
                        <StackPanel Spacing="2" HorizontalAlignment="Left" Width="145">
                            <TextBlock Text="Data Set" FontSize="12" Foreground="#000000" HorizontalAlignment="Center" />
                            <Border BorderBrush="#7F9DB9" BorderThickness="1" Background="#FFFFFF" Height="28" Padding="6,0">
                                <TextBlock Text="Sample 2" FontSize="12" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- From / To Box -->
                        <Grid Margin="0,4,0,0" HorizontalAlignment="Left" Width="175">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="135" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From" FontSize="12" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="#7F9DB9" BorderThickness="1,1,1,0" Background="#FFFFFF">
                                <TextBlock Text="1/1/2013" FontSize="12" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="To" FontSize="12" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#7F9DB9" BorderThickness="1,1,1,1" Background="#FFFFFF">
                                <TextBlock Text="1/4/2014" FontSize="12" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Middle: Daily with 7-Day Moving Average -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                        <TextBlock Text="Daily with 7-Day Moving Average" FontSize="11.5" FontWeight="SemiBold" Foreground="#000000" HorizontalAlignment="Center" Margin="0,0,0,3" />
                        
                        <Grid Height="80" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Y-Axis -->
                            <Grid Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="15000" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <TextBlock Text="10000" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-24,0,0" />
                                <TextBlock Text="5000" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,24,0,0" />
                                <TextBlock Text="0" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>

                            <!-- Graph Box -->
                            <Border Grid.Column="1" BorderBrush="#7F9DB9" BorderThickness="1,0,0,1" HorizontalAlignment="Stretch">
                                <Grid Height="80" HorizontalAlignment="Stretch">
                                    <!-- Horizontal Gridlines -->
                                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Top" />
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Center" Margin="0,-24,0,0" />
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Center" Margin="0,24,0,0" />
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Green Area Fill -->
                                    <Path Data="M 0,80 L 0,24 L 5,32 L 10,27 L 15,38 L 20,43 L 25,41 L 30,45 L 35,43 L 40,48 L 45,49 L 50,51 L 55,53 L 60,55 L 65,58 L 70,56 L 75,59 L 80,57 L 85,61 L 90,59 L 95,63 L 100,61 L 105,65 L 110,63 L 115,67 L 120,65 L 125,63 L 130,61 L 135,62 L 140,60 L 145,58 L 150,61 L 155,59 L 160,57 L 165,61 L 170,59 L 175,63 L 180,61 L 185,65 L 190,63 L 195,65 L 200,63 L 205,61 L 210,57 L 215,65 L 220,41 L 220,80 Z" Fill="#A9DFBF" Opacity="0.9" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                    <!-- Dark Green Moving Average Line -->
                                    <Path Data="M 0,24 L 5,32 L 10,27 L 15,38 L 20,43 L 25,41 L 30,45 L 35,43 L 40,48 L 45,49 L 50,51 L 55,53 L 60,55 L 65,58 L 70,56 L 75,59 L 80,57 L 85,61 L 90,59 L 95,63 L 100,61 L 105,65 L 110,63 L 115,67 L 120,65 L 125,63 L 130,61 L 135,62 L 140,60 L 145,58 L 150,61 L 155,59 L 160,57 L 165,61 L 170,59 L 175,63 L 180,61 L 185,65 L 190,63 L 195,65 L 200,63 L 205,61 L 210,57 L 215,65 L 220,41" Stroke="#27AE60" StrokeThickness="1.5" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- X-Axis Labels -->
                        <Grid Margin="34,2,0,0" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1/1/13" FontSize="7" Foreground="#000000" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="3/1/13" FontSize="7" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="5/1/13" FontSize="7" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="7/1/13" FontSize="7" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="9/1/13" FontSize="7" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="11/1/13" FontSize="7" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="1/1/14" FontSize="7" Foreground="#000000" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: Weekly Average -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                        <TextBlock Text="Weekly Average" FontSize="11.5" FontWeight="SemiBold" Foreground="#000000" HorizontalAlignment="Center" Margin="0,0,0,3" />

                        <Grid Height="80" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Y-Axis -->
                            <Grid Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="8000" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <TextBlock Text="6000" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-20,0,0" />
                                <TextBlock Text="4000" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Text="2000" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,20,0,0" />
                                <TextBlock Text="0" FontSize="8" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>

                            <!-- Graph Box -->
                            <Border Grid.Column="1" BorderBrush="#7F9DB9" BorderThickness="1,0,0,1" HorizontalAlignment="Stretch">
                                <Grid Height="80" HorizontalAlignment="Stretch">
                                    <!-- Horizontal Gridlines -->
                                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Top" />
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Center" Margin="0,-20,0,0" />
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Center" />
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Center" Margin="0,20,0,0" />
                                        <Border Height="1" Background="#E0E0E0" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Blue Line -->
                                    <Path Data="M 0,10 L 8,15 L 16,35 L 24,36 L 32,38 L 40,42 L 48,44 L 56,46 L 64,52 L 72,55 L 80,56 L 88,58 L 96,57 L 104,56 L 112,54 L 120,50 L 128,48 L 136,52 L 144,48 L 152,55 L 160,56 L 168,58 L 176,60 L 184,62 L 195,42" Stroke="#365F91" StrokeThickness="1.5" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- X-Axis Labels -->
                        <Grid Margin="28,2,0,0" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dec-12" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Jan-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Feb-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Mar-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Apr-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="May-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="Jun-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="Jul-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="Aug-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="9" Text="Sep-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="10" Text="Oct-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="11" Text="Nov-13" FontSize="6.5" Foreground="#000000" HorizontalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ==================== 2. DAY-OF-WEEK BAR CHART (Avg:) ==================== -->
                <Grid Height="36" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <!-- Month Name: 45px -->
                        <ColumnDefinition Width="45" />
                        <!-- Mini Calendar: 140px -->
                        <ColumnDefinition Width="140" />
                        <!-- 7 Days Columns (Sun - Sat): each 1* (Full Width Stretch) -->
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <!-- Weekly Average: 1.8* (Full Width Stretch) -->
                        <ColumnDefinition Width="1.8*" MinWidth="140" />
                    </Grid.ColumnDefinitions>

                    <!-- Avg: label -->
                    <TextBlock Grid.Column="1" Text="Avg:" FontSize="12.5" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,2" />

                    <!-- Day of Week Average Vertical Bars -->
                    <Border Grid.Column="2" Height="17" Width="44" Background="#4F81BD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <Border Grid.Column="3" Height="30" Width="44" Background="#4F81BD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <Border Grid.Column="4" Height="32" Width="44" Background="#4F81BD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <Border Grid.Column="5" Height="31" Width="44" Background="#4F81BD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <Border Grid.Column="6" Height="28" Width="44" Background="#4F81BD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <Border Grid.Column="7" Height="23" Width="44" Background="#4F81BD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <Border Grid.Column="8" Height="15" Width="44" Background="#4F81BD" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>

                <!-- ==================== 3. MAIN HEATMAP TABLE (FULL PAGE STRETCH) ==================== -->
                <Border BorderBrush="#365F91" BorderThickness="1,0,1,1" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">

                        <!-- Main Table Header -->
                        <Grid Height="28" Background="#365F91" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <!-- Month label & mini cal: 45px + 140px -->
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="140" />
                                <!-- 7 Days Columns: 1* each -->
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <!-- Weekly Average: 1.8* -->
                                <ColumnDefinition Width="1.8*" MinWidth="140" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="" />
                            <TextBlock Grid.Column="1" Text="Su  M  Tu  W  Th  F  Sa" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Sun" Style="{StaticResource HeaderTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Mon" Style="{StaticResource HeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Tue" Style="{StaticResource HeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="Wed" Style="{StaticResource HeaderTextStyle}" />
                            <TextBlock Grid.Column="6" Text="Thu" Style="{StaticResource HeaderTextStyle}" />
                            <TextBlock Grid.Column="7" Text="Fri" Style="{StaticResource HeaderTextStyle}" />
                            <TextBlock Grid.Column="8" Text="Sat" Style="{StaticResource HeaderTextStyle}" />
                            <TextBlock Grid.Column="9" Text="Weekly Average" Style="{StaticResource HeaderTextStyle}" />
                        </Grid>

                        <!-- 54 Rows Generated with exact mathematical Excel 3-Color Gradient (Full Width Stretch) -->
                        <StackPanel x:Name="HeatmapDataGrid" HorizontalAlignment="Stretch" />

                    </StackPanel>
                </Border>

                <!-- ==================== 4. FOOTER ==================== -->
                <Grid Margin="0,8,0,0" HorizontalAlignment="Stretch">
                    <TextBlock Text="http://www.vertex42.com/ExcelTemplates/calendar-chart.html" FontSize="8.5" Foreground="#7F7F7F" HorizontalAlignment="Left" />
                    <TextBlock Text="Calendar Chart Template © 2016 by Vertex42.com" FontSize="8.5" Foreground="#7F7F7F" HorizontalAlignment="Right" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
