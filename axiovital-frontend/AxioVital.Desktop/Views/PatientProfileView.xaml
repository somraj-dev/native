<UserControl
    x:Class="AxioVital.Desktop.Views.PatientProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:AxioVital.Desktop.Views"
    xmlns:widgets="using:AxioVital.Desktop.Widgets"
    mc:Ignorable="d">

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation Menu: 200px -->
            <ColumnDefinition Width="200" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR NAVIGATION MENU ==================== -->
        <Grid Grid.Column="0" Background="#0A3F6D">
            <Grid.RowDefinitions>
                <!-- Menu Header (Height: 26) -->
                <RowDefinition Height="26" />
                <!-- Scrollable Nav List -->
                <RowDefinition Height="*" />
                <!-- Bottom Badge (Height: 40) -->
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!-- Menu Header with Red Pin & Collapsible Arrow -->
            <Grid Grid.Row="0" Background="#083256" Padding="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Menu" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Segoe UI" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Red Pushpin Glyph -->
                    <FontIcon Glyph="&#xE718;" FontSize="11.5" Foreground="#FF3B69" VerticalAlignment="Center" />
                    <!-- Collapse Arrow Glyph -->
                    <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="#BACBD4" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Scrollable Navigation Items in Exact Reference Order -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,0,8">
                <StackPanel x:Name="SidebarNavPanel" Spacing="0">

                    <!-- 1. Provider View -->
                    <Border x:Name="NavProviderViewBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavProviderViewPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavProviderViewBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavProviderViewText" Grid.Column="1" Text="Provider View" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 2. Results Review -->
                    <Border x:Name="NavResultsReviewBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavResultsReviewPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavResultsReviewBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavResultsReviewText" Grid.Column="1" Text="Results Review" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 3. Orders -->
                    <Border x:Name="NavOrdersBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavOrdersPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavOrdersBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavOrdersText" Grid.Column="1" Text="Orders" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 4. Documentation -->
                    <Border x:Name="NavDocBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavDocPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavDocBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavDocText" Grid.Column="1" Text="Documentation" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 5. Outside Records -->
                    <Border x:Name="NavOutsideRecordsBorder" Background="Transparent" Margin="0,0,0,8" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavOutsideRecordsPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavOutsideRecordsBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavOutsideRecordsText" Grid.Column="1" Text="Outside Records" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 6. Allergies -->
                    <Border x:Name="NavAllergiesBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavAllergiesPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavAllergiesBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavAllergiesText" Grid.Column="1" Text="Allergies" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 7. Clinical Media -->
                    <Border x:Name="NavClinicalMediaBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavClinicalMediaPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavClinicalMediaBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavClinicalMediaText" Grid.Column="1" Text="Clinical Media" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 8. Diagnoses and Problems -->
                    <Border x:Name="NavDiagnosesBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavDiagnosesPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavDiagnosesBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavDiagnosesText" Grid.Column="1" Text="Diagnoses and Problems" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 9. Form Browser -->
                    <Border x:Name="NavFormBrowserBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavFormBrowserPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavFormBrowserBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavFormBrowserText" Grid.Column="1" Text="Form Browser" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 10. Growth Chart -->
                    <Border x:Name="NavGrowthChartBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavGrowthChartPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavGrowthChartBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavGrowthChartText" Grid.Column="1" Text="Growth Chart" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 11. Insurance -->
                    <Border x:Name="NavInsuranceBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavInsurancePressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavInsuranceBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavInsuranceText" Grid.Column="1" Text="Insurance" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 12. Histories -->
                    <Border x:Name="NavHistoriesBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavHistoriesPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavHistoriesBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavHistoriesText" Grid.Column="1" Text="Histories" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 13. Interactive View and I&O -->
                    <Border x:Name="NavInteractiveViewBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavInteractiveViewPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavInteractiveViewBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavInteractiveViewText" Grid.Column="1" Text="Interactive View and I&amp;O" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 14. MAR Summary -->
                    <Border x:Name="NavMarBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavMarPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavMarBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavMarText" Grid.Column="1" Text="MAR Summary" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 15. Medication List -->
                    <Border x:Name="NavMedicationBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavMedicationPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavMedicationBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavMedicationText" Grid.Column="1" Text="Medication List" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 16. Recommendations -->
                    <Border x:Name="NavRecommendationsBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavRecommendationsPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavRecommendationsBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavRecommendationsText" Grid.Column="1" Text="Recommendations" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 17. Smart App Validator -->
                    <Border x:Name="NavSmartAppValidatorBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavSmartAppValidatorPressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavSmartAppValidatorBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavSmartAppValidatorText" Grid.Column="1" Text="Smart App Validator" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 18. mTuitive - OpNote Test - IE -->
                    <Border x:Name="NavOpNoteTestIeBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavOpNoteTestIePressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavOpNoteTestIeBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavOpNoteTestIeText" Grid.Column="1" Text="mTuitive - OpNote Test - IE" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 19. mTuitive - OpNote Test - Edge -->
                    <Border x:Name="NavOpNoteTestEdgeBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavOpNoteTestEdgePressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavOpNoteTestEdgeBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavOpNoteTestEdgeText" Grid.Column="1" Text="mTuitive - OpNote Test - Edge" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 20. Op Note - Prod - Edge (ACTIVE DEFAULT VIEW) -->
                    <Border x:Name="NavOpNoteProdEdgeBorder" Background="#005C8A" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavOpNoteProdEdgePressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavOpNoteProdEdgeBar" Grid.Column="0" Background="#00A2ED" />
                            <TextBlock x:Name="NavOpNoteProdEdgeText" Grid.Column="1" Text="Op Note - Prod - Edge" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 21. WorkflowView Edge -->
                    <Border x:Name="NavWorkflowViewEdgeBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavWorkflowViewEdgePressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavWorkflowViewEdgeBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavWorkflowViewEdgeText" Grid.Column="1" Text="WorkflowView Edge" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 22. mTuitive Dev - Edge -->
                    <Border x:Name="NavMTuitiveDevEdgeBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavMTuitiveDevEdgePressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavMTuitiveDevEdgeBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavMTuitiveDevEdgeText" Grid.Column="1" Text="mTuitive Dev - Edge" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                    <!-- 23. OpNote Debug EDGE -->
                    <Border x:Name="NavOpNoteDebugEdgeBorder" Background="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited" PointerPressed="OnNavOpNoteDebugEdgePressed">
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavOpNoteDebugEdgeBar" Grid.Column="0" Background="Transparent" />
                            <TextBlock x:Name="NavOpNoteDebugEdgeText" Grid.Column="1" Text="OpNote Debug EDGE" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0" />
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Left Circle Badge 'N' -->
            <Border Grid.Row="2" Background="Transparent" Padding="14,4,14,8" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                <Grid Width="24" Height="24">
                    <Ellipse Fill="#051D2D" Width="24" Height="24" />
                    <TextBlock Text="N" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Subtle Top Breadcrumb Strip (Height: 24) -->
                <RowDefinition Height="24" />
                <!-- Main Form / Panel Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Light Gray / Soft Blue Strip -->
            <Border Grid.Row="0" Background="#E2EDF8" BorderBrush="#C6D8E8" BorderThickness="0,0,0,1" />

            <!-- Dynamic Panels Container -->
            <Grid Grid.Row="1">

                <!-- 1. OP NOTE - PROD - EDGE VIEW (DEFAULT ACTIVE VIEW MATCHING SCREENSHOT) -->
                <ScrollViewer x:Name="OpNoteProdEdgePanel" Visibility="Visible" Background="#FFFFFF" Padding="32,28,32,28">
                    <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">

                        <!-- Field 1: Implant Lot #: (optional) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
                                <TextBlock Text="Implant Lot #:" Foreground="#333333" FontSize="12" />
                                <TextBlock Text=" (optional)" Foreground="#777777" FontSize="11.5" FontStyle="Italic" />
                            </StackPanel>

                            <Grid Grid.Column="1" Width="380" HorizontalAlignment="Left">
                                <TextBox x:Name="FormImplantLotBox"
                                         Height="65"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderBrush="#B2BEC7"
                                         BorderThickness="1"
                                         CornerRadius="0"
                                         Background="#FFFFFF"
                                         Foreground="#111827"
                                         Padding="6,4"
                                         FontSize="11.5" />
                                <Border Width="6" Height="6" BorderBrush="#94A3B8" BorderThickness="0,0,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
                            </Grid>
                        </Grid>

                        <!-- Field 2: Was dermal matrix used?: (optional) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                                <TextBlock Text="Was dermal matrix used?:" Foreground="#333333" FontSize="12" />
                                <TextBlock Text=" (optional)" Foreground="#777777" FontSize="11.5" FontStyle="Italic" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <RadioButton x:Name="FormDermalYes" Content="Yes" FontSize="12" Foreground="#333333" Height="20" MinWidth="0" Padding="6,0,0,0" />
                                <RadioButton x:Name="FormDermalNo" Content="No" IsChecked="True" FontSize="12" Foreground="#333333" Height="20" MinWidth="0" Padding="6,0,0,0" />
                                <RadioButton x:Name="FormDermalUnknown" Content="Unknown" FontSize="12" Foreground="#333333" Height="20" MinWidth="0" Padding="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Field 3: Operative Description: (optional) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Operative Description:" Foreground="#333333" FontSize="12" />
                                <TextBlock Text=" (optional)" Foreground="#777777" FontSize="11.5" FontStyle="Italic" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ComboBox x:Name="FormOpDescriptionCombo" PlaceholderText="Choose an option" Width="260" Height="24" BorderBrush="#B2BEC7" CornerRadius="0" FontSize="11.5" Background="#FFFFFF" Padding="6,1" />
                                <TextBlock Text="Other..." Foreground="#006699" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Field 4: Comments: (optional) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
                                <TextBlock Text="Comments:" Foreground="#333333" FontSize="12" />
                                <TextBlock Text=" (optional)" Foreground="#777777" FontSize="11.5" FontStyle="Italic" />
                            </StackPanel>

                            <Grid Grid.Column="1" Width="380" HorizontalAlignment="Left">
                                <TextBox x:Name="FormCommentsBox"
                                         Height="65"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderBrush="#B2BEC7"
                                         BorderThickness="1"
                                         CornerRadius="0"
                                         Background="#FFFFFF"
                                         Foreground="#111827"
                                         Padding="6,4"
                                         FontSize="11.5" />
                                <Border Width="6" Height="6" BorderBrush="#94A3B8" BorderThickness="0,0,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
                            </Grid>
                        </Grid>

                        <!-- Horizontal Divider -->
                        <Rectangle Height="1" Fill="#E2E8F0" Margin="0,6,0,10" />

                        <!-- Section: Other Comments with Bright Yellow Highlights -->
                        <StackPanel Spacing="10">
                            <!-- Bright Yellow Banner -->
                            <Border Background="#FFEE00" Padding="8,3,8,3" HorizontalAlignment="Left" CornerRadius="0">
                                <TextBlock Text="Other Comments" Foreground="#000000" FontSize="12" FontWeight="Bold" />
                            </Border>

                            <!-- Bright Yellow Label & Text Area -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FFEE00" Padding="4,2,4,2" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="0">
                                    <TextBlock Text="Other Comments:" Foreground="#000000" FontSize="12" FontWeight="Bold" />
                                </Border>

                                <Grid Grid.Column="1" Width="380" HorizontalAlignment="Left">
                                    <TextBox x:Name="FormOtherCommentsBox"
                                             Height="68"
                                             Text="I am signing this report at the direction of administration, in the absence of Cerner Surgeon 1."
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Foreground="#111827"
                                             FontSize="11.5"
                                             BorderBrush="#B2BEC7"
                                             BorderThickness="1"
                                             CornerRadius="0"
                                             Background="#FFFFFF"
                                             Padding="6,4" />
                                    <Border Width="6" Height="6" BorderBrush="#94A3B8" BorderThickness="0,0,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
                                </Grid>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- 2. PROVIDER VIEW -->
                <ScrollViewer x:Name="ProviderViewPanel" Visibility="Collapsed" Background="#FFFFFF" Padding="24">
                    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Provider Clinical Summary &amp; Handoff View" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />

                        <Grid Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
