<UserControl
    x:Class="AxioVital.Desktop.Views.FileManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- File Card Style -->
        <Style x:Key="FileCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- Category Filter Button Style -->
        <Style x:Key="SidebarCategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Active Category Button Style -->
        <Style x:Key="SidebarCategoryActiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarCategoryButtonStyle}">
            <Setter Property="Background" Value="#E8F0FE" />
        </Style>

        <!-- Upload Button Style -->
        <Style x:Key="UploadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#083C64" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F7FA">
        <Grid.RowDefinitions>
            <!-- 0. Top Header Bar -->
            <RowDefinition Height="50" />
            <!-- 1. Main Work Area (Sidebar + Content + Preview) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. TOP HEADER BAR ==================== -->
        <Grid Grid.Row="0" Background="#063C64" Padding="14,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back to Chart Button & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Padding="10,6" Background="#0C4F80" BorderThickness="0" CornerRadius="4" Click="OnBackToChartClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="←" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="Back to Chart" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="#1B5B8A" Margin="4,0" />

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Medical Document &amp; File Profiler" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Background="#032640" BorderBrush="#1C72A8" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Text="Patient: TESTPROD, ONE (MRN: 000000000000000013)" Foreground="#9CD6FF" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Right Info & Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#084978" CornerRadius="12" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔒 Encrypted Object Store (MinIO S3)" Foreground="#D0E6FA" FontSize="11" />
                    </StackPanel>
                </Border>

                <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Click="OnBackToChartClicked">
                    <TextBlock Text="✕" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. MAIN WORK AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="230" />
                <!-- Main Content -->
                <ColumnDefinition Width="*" />
                <!-- Preview Panel (slide-in) -->
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR ==================== -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Upload Button -->
                    <Button Grid.Row="0" Style="{StaticResource UploadButtonStyle}" 
                            HorizontalAlignment="Stretch" Click="OnUploadClicked"
                            Margin="14,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="＋" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="Upload Document" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Section Header -->
                    <TextBlock Grid.Row="2" Text="CATEGORIES" FontSize="10" FontWeight="Bold" 
                               Foreground="#8896A6" Margin="18,0,0,6" />

                    <!-- Category Filters -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2" Margin="6,0">
                            <Button x:Name="FilterAll" Style="{StaticResource SidebarCategoryActiveStyle}" Click="OnFilterAllClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FilterAllText" Text="All Files" FontSize="12" FontWeight="SemiBold" Foreground="#1A73E8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FilterAllCount" Text="" FontSize="11" Foreground="#8896A6" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterMedicalReport" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterMedicalReportClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Medical Reports" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterLabResult" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterLabResultClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="🔬" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Lab Results" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterImaging" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterImagingClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="🩻" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Imaging Studies (DICOM)" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterPrescription" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterPrescriptionClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="💊" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Prescriptions" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterInsurance" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterInsuranceClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Insurance &amp; Claims" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterConsent" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterConsentClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="✍️" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Consent Forms" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterReferral" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterReferralClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📨" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Referrals" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterSurgical" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterSurgicalClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="🏥" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Surgical Notes" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FilterOther" Style="{StaticResource SidebarCategoryButtonStyle}" Click="OnFilterOtherClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Other Formats" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Storage Stats -->
                    <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="STORAGE CAPACITY" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" />
                            <ProgressBar Value="34" Maximum="100" Height="5" Foreground="#083C64" Background="#E2E8F0" CornerRadius="2.5" />
                            <TextBlock Text="247.3 MB / 10 GB (3.4%)" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== MAIN CONTENT ==================== -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <!-- Toolbar -->
                    <RowDefinition Height="54" />
                    <!-- Storage & Format Chips Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- File Grid / List Scroll Area -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== TOOLBAR ===== -->
                <Grid Grid.Row="0" Background="#FFFFFF" Padding="18,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="12,0" MaxWidth="480" HorizontalAlignment="Left" Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search reports, lab tests, scans, prescriptions..." 
                                     Background="Transparent" BorderThickness="0" FontSize="12"
                                     VerticalAlignment="Center" TextChanged="OnSearchTextChanged" />
                        </Grid>
                    </Border>

                    <!-- View Toggle & Sort -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Grid View Toggle -->
                        <Button x:Name="GridViewBtn" Padding="8,5" MinWidth="0" MinHeight="0" Background="#E8F0FE" BorderThickness="0" CornerRadius="4"
                                Click="OnGridViewClicked">
                            <TextBlock Text="▦ Grid" FontSize="12" FontWeight="SemiBold" Foreground="#1A73E8" />
                        </Button>
                        <!-- List View Toggle -->
                        <Button x:Name="ListViewBtn" Padding="8,5" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" CornerRadius="4"
                                Click="OnListViewClicked">
                            <TextBlock Text="☰ List" FontSize="12" Foreground="#6B7280" />
                        </Button>

                        <!-- Sort Dropdown -->
                        <ComboBox x:Name="SortComboBox" Width="145" SelectedIndex="0" FontSize="11.5" Height="32" SelectionChanged="OnSortChanged">
                            <ComboBoxItem Content="Date (Newest)" />
                            <ComboBoxItem Content="Date (Oldest)" />
                            <ComboBoxItem Content="Name (A-Z)" />
                            <ComboBoxItem Content="Name (Z-A)" />
                            <ComboBoxItem Content="Size (Largest)" />
                            <ComboBoxItem Content="Size (Smallest)" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- ===== STORAGE & FORMAT CHIPS BAR ===== -->
                <Border Grid.Row="1" Background="#FFFFFF" Padding="18,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="FileCountText" Text="18 files" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                            <TextBlock Text="·" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalSizeText" Text="247.3 MB total" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Format Tag Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0" VerticalAlignment="Center">
                            <Border Background="#FEE2E2" CornerRadius="10" Padding="6,2">
                                <TextBlock Text="PDF (8)" FontSize="10" FontWeight="Bold" Foreground="#991B1B" />
                            </Border>
                            <Border Background="#CCFBF1" CornerRadius="10" Padding="6,2">
                                <TextBlock Text="DICOM (2)" FontSize="10" FontWeight="Bold" Foreground="#0F766E" />
                            </Border>
                            <Border Background="#D1FAE5" CornerRadius="10" Padding="6,2">
                                <TextBlock Text="XLSX/CSV (2)" FontSize="10" FontWeight="Bold" Foreground="#065F46" />
                            </Border>
                            <Border Background="#FEF3C7" CornerRadius="10" Padding="6,2">
                                <TextBlock Text="Images (2)" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                            </Border>
                            <Border Background="#DBEAFE" CornerRadius="10" Padding="6,2">
                                <TextBlock Text="DOCX (1)" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" />
                            </Border>
                            <Border Background="#F3E8FF" CornerRadius="10" Padding="6,2">
                                <TextBlock Text="Data/Text (3)" FontSize="10" FontWeight="Bold" Foreground="#6B21A8" />
                            </Border>
                        </StackPanel>

                        <!-- Quick Whitelist Info -->
                        <TextBlock Grid.Column="2" Text="✓ All 20+ Medical Formats Supported" FontSize="11" Foreground="#059669" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ===== FILE GRID VIEW ===== -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <!-- Grid View -->
                        <GridView x:Name="FileGridView" SelectionMode="None" IsItemClickEnabled="False">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="195" ItemHeight="170" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <!-- List View -->
                        <Grid x:Name="FileListView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- List Header -->
                            <Grid Grid.Row="0" Background="#F1F5F9" Padding="14,8" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="" />
                                <TextBlock Grid.Column="1" Text="Document Name" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                <TextBlock Grid.Column="2" Text="Format" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                <TextBlock Grid.Column="3" Text="Size" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                <TextBlock Grid.Column="4" Text="Category" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                <TextBlock Grid.Column="5" Text="Uploaded By" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                <TextBlock Grid.Column="6" Text="Action" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            </Grid>

                            <!-- List Items -->
                            <ItemsControl x:Name="FileListItems" Grid.Row="1" />
                        </Grid>

                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="12" Margin="0,80,0,0">
                            <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="No medical documents found" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#374151" HorizontalAlignment="Center" />
                            <TextBlock Text="Upload medical reports, lab results, imaging scans, and prescriptions"
                                       FontSize="12.5" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource UploadButtonStyle}" 
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnUploadClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="＋" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="Upload First Document" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ==================== PREVIEW PANEL (slide-in) ==================== -->
            <Border x:Name="PreviewPanel" Grid.Column="2" Background="#FFFFFF" 
                    BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" 
                    Visibility="Collapsed" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="46" />
                        <!-- Content -->
                        <RowDefinition Height="*" />
                        <!-- Metadata Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Actions -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Grid Grid.Row="0" Padding="14,8" Background="#083C64" BorderBrush="#0A4D80" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewFileName" Text="Document Details" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Padding="6,4" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0" Click="OnClosePreviewClicked">
                            <TextBlock Text="✕" FontSize="12" Foreground="#FFFFFF" FontWeight="Bold" />
                        </Button>
                    </Grid>

                    <!-- Preview Content / Visualizer Area -->
                    <ScrollViewer Grid.Row="1" Background="#F8FAFC" Padding="14">
                        <StackPanel Spacing="12">
                            <!-- Visual Thumbnail / Icon Box -->
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock x:Name="PreviewIcon" Text="📄" FontSize="56" HorizontalAlignment="Center" />
                                    <Border x:Name="PreviewFormatBadge" Background="#083C64" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PreviewFileType" Text="PDF DOCUMENT" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Specialized Details Card (DICOM / Lab / Clinical) -->
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DOCUMENT SPECIFICATIONS" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Category:" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock x:Name="PreviewCategoryText" Grid.Row="0" Grid.Column="1" Text="Medical Report" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File Size:" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock x:Name="PreviewFileSize" Grid.Row="1" Grid.Column="1" Text="2.45 MB" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Uploaded By:" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock x:Name="PreviewUploadedBy" Grid.Row="2" Grid.Column="1" Text="Dr. Sarah Chen" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Timestamp:" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock x:Name="PreviewTimestamp" Grid.Row="3" Grid.Column="1" Text="Aug 28, 2026 10:45 AM" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock x:Name="PreviewDescription" Grid.Row="4" Grid.Column="1" Text="Patient discharge summary" FontSize="11" Foreground="#334155" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Preview Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="14,10"
                                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Button Padding="14,7" MinWidth="0" MinHeight="0" Background="#083C64" 
                                BorderThickness="0" CornerRadius="4" Click="OnDownloadClicked">
                            <TextBlock Text="⬇ Download" FontSize="11.5" Foreground="#FFFFFF" FontWeight="Bold" />
                        </Button>
                        <Button Padding="14,7" MinWidth="0" MinHeight="0" Background="#F1F5F9" 
                                BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Click="OnViewInViewerClicked">
                            <TextBlock Text="👁 View" FontSize="11.5" Foreground="#1E293B" FontWeight="SemiBold" />
                        </Button>
                        <Button Padding="10,7" MinWidth="0" MinHeight="0" Background="#FEE2E2" 
                                BorderThickness="0" CornerRadius="4" Click="OnDeleteClicked">
                            <TextBlock Text="🗑" FontSize="12" Foreground="#DC2626" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
