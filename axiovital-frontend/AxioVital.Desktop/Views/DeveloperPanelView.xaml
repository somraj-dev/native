<UserControl
    x:Class="AxioVital.Desktop.Views.DeveloperPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <!-- 0. Dark Navy Top Header Bar (Height: 32) -->
            <RowDefinition Height="32" />
            <!-- 1. Sub-Header Toolbar (Height: 26) -->
            <RowDefinition Height="26" />
            <!-- 2. Main 2-Column Workspace Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. TOP HEADER BAR ==================== -->
        <Border Grid.Row="0" Background="#083760" Padding="12,0,16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title: AxioVital Developer Panel -->
                <TextBlock Grid.Column="0"
                           Text="AxioVital Developer Panel"
                           FontSize="12.5"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />

                <!-- Right Links: Logout | Help | Refresh Page -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Logout" FontSize="10.5" Foreground="#93CBED" VerticalAlignment="Center" PointerPressed="OnReturnToAxioVitalPointerPressed" />
                    <TextBlock Text="|" FontSize="10.5" Foreground="#4A7C9F" VerticalAlignment="Center" />
                    <TextBlock Text="Help" FontSize="10.5" Foreground="#93CBED" VerticalAlignment="Center" />
                    <TextBlock Text="|" FontSize="10.5" Foreground="#4A7C9F" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh Page" FontSize="10.5" Foreground="#93CBED" VerticalAlignment="Center" PointerPressed="OnReturnToAxioVitalPointerPressed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1. SUB-HEADER TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="#D2E0EC" BorderBrush="#B8C8D8" BorderThickness="0,0,0,1" Padding="8,0,8,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <!-- Return to AxioVital Button -->
                <Border Background="#DCE7F2" BorderBrush="#A4BACD" BorderThickness="1" CornerRadius="2" Padding="7,2" Margin="0,0,0,2" PointerPressed="OnReturnToAxioVitalPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="&lt;" FontSize="10.5" FontWeight="Bold" Foreground="#0C2B4E" VerticalAlignment="Center" />
                        <TextBlock Text="Return to AxioVital" FontSize="10.5" FontWeight="SemiBold" Foreground="#0C2B4E" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Search Tab -->
                <Border Background="#FFFFFF" BorderBrush="#A4BACD" BorderThickness="1,1,1,0" CornerRadius="2,2,0,0" Padding="14,3" VerticalAlignment="Bottom">
                    <TextBlock Text="Search" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ==================== 2. MAIN 2-COLUMN BODY ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Menu (~235px) -->
                <ColumnDefinition Width="235" MinWidth="200" MaxWidth="300" />
                <!-- Right Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Expandable & Collapsible Tree Menu -->
            <Border Grid.Column="0" Background="#EDF3F8" BorderBrush="#C5D4E3" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,6,6,6">
                        <StackPanel Spacing="1">

                            <!-- 1. My Content Server (+) -->
                            <StackPanel>
                                <Border Padding="4,2.5" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="mycontent">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="MyContentToggleGlyph" Text="+" FontSize="12" FontWeight="Bold" Foreground="#584B98" Width="12" VerticalAlignment="Center" />
                                        <TextBlock Text="My Content Server" FontSize="10.5" FontWeight="SemiBold" Foreground="#183A5D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="MyContentChildrenPanel" Visibility="Collapsed" Margin="16,0,0,0" Spacing="1">
                                    <TextBlock Text="My Checked-Out Content" FontSize="10" Foreground="#334155" Margin="4,2" />
                                    <TextBlock Text="My Saved Queries" FontSize="10" Foreground="#334155" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 2. Browse Content (+) -->
                            <StackPanel>
                                <Border Padding="4,2.5" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="browse">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="BrowseToggleGlyph" Text="+" FontSize="12" FontWeight="Bold" Foreground="#584B98" Width="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Browse Content" FontSize="10.5" FontWeight="SemiBold" Foreground="#183A5D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="BrowseChildrenPanel" Visibility="Collapsed" Margin="16,0,0,0" Spacing="1">
                                    <TextBlock Text="Library Folders" FontSize="10" Foreground="#334155" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 3. Search (+) -->
                            <StackPanel>
                                <Border Padding="4,2.5" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="search">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="SearchToggleGlyph" Text="+" FontSize="12" FontWeight="Bold" Foreground="#584B98" Width="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Search" FontSize="10.5" FontWeight="SemiBold" Foreground="#183A5D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="SearchChildrenPanel" Visibility="Collapsed" Margin="16,0,0,0" Spacing="1">
                                    <TextBlock Text="Standard Search" FontSize="10" Foreground="#334155" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 4. Content Management (+) -->
                            <StackPanel>
                                <Border Padding="4,2.5" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="contentmgmt">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="ContentMgmtToggleGlyph" Text="+" FontSize="12" FontWeight="Bold" Foreground="#584B98" Width="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Content Management" FontSize="10.5" FontWeight="SemiBold" Foreground="#183A5D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="ContentMgmtChildrenPanel" Visibility="Collapsed" Margin="16,0,0,0" Spacing="1">
                                    <TextBlock Text="Active Workflows" FontSize="10" Foreground="#334155" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 5. Administration (-) -->
                            <StackPanel>
                                <Border Padding="4,2.5" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="admin">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="AdminToggleGlyph" Text="-" FontSize="13" FontWeight="Bold" Foreground="#584B98" Width="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Administration" FontSize="10.5" FontWeight="Bold" Foreground="#183A5D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Direct Administration Sub-Items (Log Files & its children) -->
                                <StackPanel x:Name="AdminChildrenPanel" Visibility="Visible" Margin="10,0,0,0" Spacing="1">

                                    <!-- Log Files (-) -->
                                    <StackPanel>
                                        <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="logfiles">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock x:Name="LogFilesToggleGlyph" Text="-" FontSize="12" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                                <TextBlock Text="Log Files" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Log Files Sub-Items (Component Manager Selected) -->
                                        <StackPanel x:Name="LogFilesChildrenPanel" Visibility="Visible" Margin="10,0,0,0" Spacing="1">
                                            
                                            <!-- Component Manager (ACTIVE SELECTED) -->
                                            <Border x:Name="ComponentManagerBorder" Background="#DDE7F2" CornerRadius="2" Padding="6,2.5" PointerPressed="OnMenuItemSelected" Tag="component_manager">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="▤" FontSize="9" Foreground="#0B4F8A" VerticalAlignment="Center" />
                                                    <TextBlock Text="Component Manager" FontSize="10.5" FontWeight="Bold" Foreground="#0B4F8A" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- General Configuration -->
                                            <Border x:Name="GeneralConfigBorder" Background="Transparent" CornerRadius="2" Padding="6,2.5" PointerPressed="OnMenuItemSelected" Tag="general_config">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="▥" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Text="General Configuration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Content Security -->
                                            <Border x:Name="ContentSecurityBorder" Background="Transparent" CornerRadius="2" Padding="6,2.5" PointerPressed="OnMenuItemSelected" Tag="content_security">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="▥" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Text="Content Security" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Internet Configuration -->
                                            <Border x:Name="InternetConfigBorder" Background="Transparent" CornerRadius="2" Padding="6,2.5" PointerPressed="OnMenuItemSelected" Tag="internet_config">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="▥" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Text="Internet Configuration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>

                            <!-- 6. Refinery Administration (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="refinery">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="RefineryToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Refinery Administration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="RefineryChildrenPanel" Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock Text="Refinery Status" FontSize="10" Foreground="#475569" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 7. Scheduled Jobs Administration (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="scheduledjobs">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="ScheduledJobsToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Scheduled Jobs Administration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="ScheduledJobsChildrenPanel" Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock Text="Active Jobs" FontSize="10" Foreground="#475569" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 8. Admin Server (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="adminserver">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="AdminServerToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Admin Server" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Admin Server Children (Environment Packager, Localization, DataStoreDesign SQL Generation) -->
                                <StackPanel x:Name="AdminServerChildrenPanel" Visibility="Visible" Margin="10,0,0,0" Spacing="1">
                                    <Border Padding="6,2,4,2" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="▫" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Text="Environment Packager" FontSize="10" Foreground="#475569" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="6,2,4,2" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="▫" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Text="Localization" FontSize="10" Foreground="#475569" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="6,2,4,2" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="▫" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Text="DataStoreDesign SQL Generation" FontSize="10" Foreground="#475569" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 9. FrameworkFolders Configuration (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="frameworkfolders">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="FrameworkFoldersToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="FrameworkFolders Configuration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="FrameworkFoldersChildrenPanel" Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock Text="Folders Settings" FontSize="10" Foreground="#475569" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 10. Imaging Migration Administration (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="imagingmigration">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="ImagingMigrationToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Imaging Migration Administration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="ImagingMigrationChildrenPanel" Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock Text="Migration Tasks" FontSize="10" Foreground="#475569" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 11. Folders Retention Administration (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="foldersretention">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="FoldersRetentionToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Folders Retention Administration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="FoldersRetentionChildrenPanel" Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock Text="Retention Policies" FontSize="10" Foreground="#475569" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 12. SmartContent (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="smartcontent">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="SmartContentToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="SmartContent" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="SmartContentChildrenPanel" Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock Text="Smart Configuration" FontSize="10" Foreground="#475569" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 13. Site Studio Administration (+) -->
                            <StackPanel>
                                <Border Padding="4,2" Background="Transparent" PointerPressed="OnTreeTogglePointerPressed" Tag="sitestudio">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="SiteStudioToggleGlyph" Text="+" FontSize="11" FontWeight="Bold" Foreground="#584B98" Width="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Site Studio Administration" FontSize="10" Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="SiteStudioChildrenPanel" Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock Text="Site Studio Setup" FontSize="10" Foreground="#475569" Margin="4,2" />
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Left: Circular Badge 'N' -->
                    <Border Grid.Row="1" Padding="12,8">
                        <Border Width="26" Height="26" Background="#1E1E1E" CornerRadius="13" HorizontalAlignment="Left">
                            <TextBlock Text="N" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT MAIN CONTENT: Component Manager - Core Application Settings -->
            <Grid Grid.Column="1" Background="#FFFFFF" Padding="12">
                <Border BorderBrush="#C2D3E3" BorderThickness="1" CornerRadius="3" Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Card Header (Height: 34) -->
                            <RowDefinition Height="34" />
                            <!-- Informational Banner -->
                            <RowDefinition Height="Auto" />
                            <!-- Scrollable Components List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0" CornerRadius="3,3,0,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CardTitleText"
                                           Grid.Column="0"
                                           Text="Component Manager - Core Application Settings"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="Refresh Settings"
                                        FontSize="10.5"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="10,2"
                                        Height="24"
                                        Click="OnRefreshSettingsClicked" />
                            </Grid>
                        </Border>

                        <!-- Informational Banner -->
                        <Border Grid.Row="1" Background="#EBF3FC" BorderBrush="#B8D5EF" BorderThickness="1" CornerRadius="3" Margin="12,10,12,10" Padding="12,8">
                            <TextBlock Text="Select or deselect the options below to activate or deactivate the respective configuration elements across this environment. After making changes, click the Save Changes button to apply settings."
                                       FontSize="10.5"
                                       Foreground="#1E3A5F"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Scrollable Components List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,6,14,14">
                            <StackPanel Spacing="14">

                                <!-- 1. Imaging (Checked) -->
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="ImagingCheck" IsChecked="True" Content="Imaging" FontSize="11" FontWeight="Bold" Foreground="#07365A" />
                                    <TextBlock Text="This Component acts as the interface for any IPM Documents checked into Content Server and tools such as ADF Viewer use functionality and services provided by this component."
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="28,0,0,0" />
                                </StackPanel>

                                <!-- 2. IpmRepository (Unchecked) -->
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="IpmRepositoryCheck" IsChecked="False" Content="IpmRepository" FontSize="11" FontWeight="Bold" Foreground="#07365A" />
                                    <TextBlock Text="The IpmRepository component adds functionality to the content server to allow Oracle WebCenter Content: Imaging to store documents and metadata in the content server."
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="28,0,0,0" />
                                </StackPanel>

                                <!-- 3. LinkManager (Checked) -->
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="LinkManagerCheck" IsChecked="True" Content="LinkManager" FontSize="11" FontWeight="Bold" Foreground="#07365A" />
                                    <TextBlock Text="This component extracts URL links of indexed documents, evaluates, filters and parses the URLs according to a pattern engine and then stores the results in a database table. Since the link extraction happens during the indexing cycle, only the links of released documents are managed."
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="28,0,0,0" />
                                </StackPanel>

                                <!-- 4. MSOfficeHtmlConverterSupport (Unchecked) -->
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="MSOfficeHtmlConverterCheck" IsChecked="False" Content="MSOfficeHtmlConverterSupport" FontSize="11" FontWeight="Bold" Foreground="#07365A" />
                                    <TextBlock Text="The MSOfficeHtmlConverter component requires the IBR be running on MS Windows and MS Office installed with IBR. This component allows the Inbound Refinery to convert native MS Office formats (Word, Excel, Powerpoint and Visio) to HTML using the Office application."
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="28,0,0,0" />
                                </StackPanel>

                                <!-- 5. OracleDocumentsFolders (Unchecked) -->
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="OracleDocumentsFoldersCheck" IsChecked="False" Content="OracleDocumentsFolders" FontSize="11" FontWeight="Bold" Foreground="#07365A" />
                                    <TextBlock Text="This component enables Content Server to seamlessly integrate with Oracle Content and Experience Cloud. It allows user to store and retrieve documents stored in Oracle Content and Experience Cloud. It also provides the ability to copy content stored in the Content Server to Oracle Content and Experience Cloud."
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="28,0,0,0" />
                                </StackPanel>

                                <!-- 6. PDFWatermark (Unchecked) -->
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="PDFWatermarkCheck" IsChecked="False" Content="PDFWatermark" FontSize="11" FontWeight="Bold" Foreground="#07365A" />
                                    <TextBlock Text="PDFWatermark enables watermarks to be applied to PDF files generated by the Inbound Refinery's PDFConverter component and returned to the Content Server. Existing PDF files, already residing on the Content Server can also be watermarked. Dynamic watermarks are generated on-the-fly and can contain variable information."
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="28,0,0,0" />
                                </StackPanel>

                                <!-- 7. PortalVCRHelper (Checked) -->
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="PortalVCRHelperCheck" IsChecked="True" Content="PortalVCRHelper" FontSize="11" FontWeight="Bold" Foreground="#07365A" />
                                    <TextBlock Text="PortalVCRHelper is used to integrate SiteStudio into WebCenter Portal's Content Presenter component. PortalVCRHelper should be enabled in order to surface SiteStudio content within WebCenter Portal."
                                               FontSize="10"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="28,0,0,0" />
                                </StackPanel>

                                <!-- 8. RedwoodUI (Checked) -->
                                <StackPanel Spacing="2">
