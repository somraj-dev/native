<Page
    x:Class="AxioVital.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#005C8A">

    <Grid Padding="24">
        <!-- 1. Top Left Header Brand -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="8">
            <Border Width="24" Height="24" Background="Black" CornerRadius="4">
                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="500" Height="500">
                        <Path Fill="White" Data="M 138 290 C 130 270 135 242 153 226 C 180 202 214 180 255 180 C 285 180 307 195 307 225 C 307 248 288 268 250 252 C 205 234 165 240 152 284 C 148 296 142 298 138 290 Z" />
                        <Path Fill="White" Data="M 362 210 C 370 230 365 258 347 274 C 320 298 286 320 245 320 C 215 320 193 305 193 275 C 193 252 212 232 250 248 C 295 266 335 260 348 216 C 352 204 358 202 362 210 Z" />
                        <Path Fill="White" Data="M 153 226 C 190 170 300 170 307 245 C 290 252 270 248 250 238 C 210 218 175 220 153 226 Z" />
                        <Path Fill="White" Data="M 347 274 C 310 330 200 330 193 255 C 210 248 230 252 250 262 C 290 282 325 280 347 274 Z" />
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="AxioVital" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 2. Main Center Content -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Large Title -->
            <TextBlock
                Grid.Row="0"
                Text="AxioVital Environment ™"
                Foreground="#5C8CA8"
                FontSize="34"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,36" />

            <!-- Login Form Controls Container -->
            <StackPanel Grid.Row="1" Width="260" HorizontalAlignment="Center">

                <!-- User Name Field -->
                <TextBlock Text="User Name :" Foreground="White" FontSize="12" FontWeight="Normal" Margin="0,0,0,4" />
                <ComboBox
                    ItemsSource="{Binding Users}"
                    SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                    Width="260"
                    Height="26"
                    Padding="6,2,6,2"
                    HorizontalAlignment="Stretch"
                    Background="White"
                    Foreground="Black"
                    CornerRadius="0"
                    BorderBrush="#888888"
                    BorderThickness="1"
                    Margin="0,0,0,12" />

                <!-- Password Field -->
                <TextBlock Text="Password :" Foreground="White" FontSize="12" FontWeight="Normal" Margin="0,0,0,4" />
                <PasswordBox
                    x:Name="PasswordInput"
                    PasswordChanged="PasswordInput_PasswordChanged"
                    Width="260"
                    Height="26"
                    Padding="6,2,6,2"
                    HorizontalAlignment="Stretch"
                    Background="White"
                    Foreground="Black"
                    CornerRadius="0"
                    BorderBrush="#888888"
                    BorderThickness="1"
                    Margin="0,0,0,12" />

                <!-- Domain Field -->
                <TextBlock Text="Domain :" Foreground="White" FontSize="12" FontWeight="Normal" Margin="0,0,0,4" />
                <ComboBox
                    ItemsSource="{Binding Domains}"
                    SelectedItem="{Binding SelectedDomain, Mode=TwoWay}"
                    Width="260"
                    Height="26"
                    Padding="6,2,6,2"
                    HorizontalAlignment="Stretch"
                    Background="White"
                    Foreground="Black"
                    CornerRadius="0"
                    BorderBrush="#888888"
                    BorderThickness="1"
                    Margin="0,0,0,18" />

                <!-- Status / Error Message -->
                <TextBlock
                    Text="{Binding StatusMessage}"
                    Foreground="#FF9999"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessageVisibility}" />

                <!-- Action Buttons Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button
                        Content="OK"
                        Command="{Binding LoginCommand}"
                        Width="85"
                        Height="26"
                        Padding="0"
                        Background="#D4D4D4"
                        Foreground="Black"
                        BorderBrush="#777777"
                        BorderThickness="1"
                        CornerRadius="0"
                        FontSize="11"
                        FontWeight="Normal" />

                    <Button
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="85"
                        Height="26"
                        Padding="0"
                        Background="#D4D4D4"
                        Foreground="Black"
                        BorderBrush="#777777"
                        BorderThickness="1"
                        CornerRadius="0"
                        FontSize="11"
                        FontWeight="Normal" />
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- 3. Bottom Left Footer Section -->
        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Footer Text Stack -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="1" MaxWidth="800">
                <TextBlock Text="Operating Environment" Foreground="White" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="© 2026 AxioVital Corporation. All rights reserved." Foreground="#6E9BB8" FontSize="10" />
                <TextBlock Text="Access and use of this solution system (including components thereof) require, and are governed by, license(s) from AxioVital Corporation." Foreground="#5F8FA9" FontSize="9" TextWrapping="Wrap" />
                <TextBlock Text="Unauthorized use, access, reproduction, display or distribution of any portion of this solution or the data contained therein may result in severe civil damages and criminal penalties. Further Information may be found in Help/About." Foreground="#5F8FA9" FontSize="9" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
