<UserControl
    x:Class="AxioVital.Desktop.Views.ReferralsTransferListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AxioVital.Desktop.Models"
    mc:Ignorable="d"
    FontFamily="Segoe UI">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <!-- 0. Header Summary -->
            <RowDefinition Height="Auto" />
            <!-- 1. Data Table Area with Column Headers -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Total Patients Summary Header -->
        <Grid Grid.Row="0" Background="White" Padding="14,8,14,8" BorderBrush="#E2E6EA" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TotalPatientsBannerText" Text="Total Patients: 32" Foreground="#002D4A" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== 1. MAIN DATA TABLE WITH COLUMN HEADERS ==================== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Row -->
                    <RowDefinition Height="28" />
                    <!-- Items Container -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers (Styling matches PatientListView / DischargeListView) -->
                <Grid Grid.Row="0" Background="#E2EAF0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />   <!-- 0. MRN -->
                        <ColumnDefinition Width="105" />  <!-- 1. Axio ID -->
                        <ColumnDefinition Width="200" />  <!-- 2. Patient Name -->
                        <ColumnDefinition Width="105" />  <!-- 3. Age / Gender -->
                        <ColumnDefinition Width="85" />   <!-- 4. DOB -->
                        <ColumnDefinition Width="145" />  <!-- 5. Transfer Type -->
                        <ColumnDefinition Width="175" />  <!-- 6. Sending Facility / Unit -->
                        <ColumnDefinition Width="190" />  <!-- 7. Receiving Facility / Provider -->
                        <ColumnDefinition Width="145" />  <!-- 8. Request Date / Time -->
                        <ColumnDefinition Width="145" />  <!-- 9. Transfer Date / Time -->
                        <ColumnDefinition Width="160" />  <!-- 10. Attending Physician -->
                        <ColumnDefinition Width="165" />  <!-- 11. Status / Workflow -->
                        <ColumnDefinition Width="200" />  <!-- 12. Reason / Priority -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="MRN" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="UUID / Axio ID" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Patient Name" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Age / Gender" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="DOB" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="5" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Transfer Type" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="6" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Sending Facility" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="7" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Receiving Facility / Spec." Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="8" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Request Date / Time" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="9" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Transfer Date / Time" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="10" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Attending Physician" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="11" BorderBrush="#C2D3E0" BorderThickness="0,0,1,1" Padding="6,2">
                        <TextBlock Text="Status / Workflow" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="12" BorderBrush="#C2D3E0" BorderThickness="0,0,0,1" Padding="6,2">
                        <TextBlock Text="Reason / Priority" Foreground="#334455" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Data Rows Container (ItemsControl) -->
                <ItemsControl x:Name="ReferralItemsControl" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ReferralTransferPatientItem">
                            <Border BorderBrush="#E2E6EA" BorderThickness="0,0,0,1" Background="{x:Bind RowBackground}" PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85" />   <!-- 0. MRN -->
                                        <ColumnDefinition Width="105" />  <!-- 1. Axio ID -->
                                        <ColumnDefinition Width="200" />  <!-- 2. Patient Name -->
                                        <ColumnDefinition Width="105" />  <!-- 3. Age / Gender -->
                                        <ColumnDefinition Width="85" />   <!-- 4. DOB -->
                                        <ColumnDefinition Width="145" />  <!-- 5. Transfer Type -->
                                        <ColumnDefinition Width="175" />  <!-- 6. Sending Facility / Unit -->
                                        <ColumnDefinition Width="190" />  <!-- 7. Receiving Facility / Provider -->
                                        <ColumnDefinition Width="145" />  <!-- 8. Request Date / Time -->
                                        <ColumnDefinition Width="145" />  <!-- 9. Transfer Date / Time -->
                                        <ColumnDefinition Width="160" />  <!-- 10. Attending Physician -->
                                        <ColumnDefinition Width="165" />  <!-- 11. Status / Workflow -->
                                        <ColumnDefinition Width="200" />  <!-- 12. Reason / Priority -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 0. MRN -->
                                    <Border Grid.Column="0" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind MRN}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 1. Axio ID -->
                                    <Border Grid.Column="1" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind AxioId}" Foreground="#555555" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 2. Patient Name (Clickable link to open patient profile) -->
                                    <Border Grid.Column="2" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind PatientName}" 
                                                   Foreground="#0066CC" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="11.5" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis"
                                                   PointerPressed="OnPatientNamePointerPressed" />
                                    </Border>

                                    <!-- 3. Age / Gender -->
                                    <Border Grid.Column="3" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind AgeGender}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 4. DOB -->
                                    <Border Grid.Column="4" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind DOB}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 5. Transfer Type -->
                                    <Border Grid.Column="5" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind TransferType}" Foreground="#1E293B" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 6. Sending Facility / Unit -->
                                    <Border Grid.Column="6" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind SendingFacility}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 7. Receiving Facility / Provider -->
                                    <Border Grid.Column="7" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind ReceivingFacility}" Foreground="#0369A1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 8. Request Date / Time -->
                                    <Border Grid.Column="8" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind RequestDate}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 9. Transfer Date / Time -->
                                    <Border Grid.Column="9" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind TransferDate}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 10. Attending Physician -->
                                    <Border Grid.Column="10" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="6,1">
                                        <TextBlock Text="{x:Bind AttendingPhysician}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 11. Status / Workflow Badge -->
                                    <Border Grid.Column="11" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0" Padding="4,1">
                                        <Border Background="{x:Bind StatusBackground}" 
                                                BorderBrush="{x:Bind StatusBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="3" 
                                                Padding="6,2" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusBadgeText}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{x:Bind StatusForeground}" 
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Border>

                                    <!-- 12. Reason / Priority -->
                                    <Border Grid.Column="12" Padding="6,1">
                                        <TextBlock Text="{x:Bind Reason}" Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
