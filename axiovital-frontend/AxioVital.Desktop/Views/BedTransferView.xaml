<UserControl
    x:Class="AxioVital.Desktop.Views.BedTransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <!-- Outer Modal Dialog Window -->
    <Border Width="680"
            Background="#FFFFFF"
            BorderBrush="#94A3B8"
            BorderThickness="1"
            CornerRadius="4">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Header Title Bar -->
                <RowDefinition Height="30" />
                <!-- 1. Form Content -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 0. HEADER TITLE BAR ==================== -->
            <Border Grid.Row="0" BorderBrush="#B0C4DE" BorderThickness="0,0,0,1" CornerRadius="3,3,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EAF2FA" Offset="0.0" />
                        <GradientStop Color="#D2E3F4" Offset="0.5" />
                        <GradientStop Color="#BDD6EE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Padding="10,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Bed Transfer"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center" />

                    <!-- Close Button (Red Square with White ✕) -->
                    <Button Grid.Column="1"
                            x:Name="CloseTitleButton"
                            Width="30"
                            Height="20"
                            Padding="0"
                            Margin="0"
                            MinHeight="0"
                            MinWidth="0"
                            Background="#D32F2F"
                            BorderThickness="0"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Click="OnCancelClicked">
                        <TextBlock Text="✕"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== 1. FORM CONTENT ==================== -->
            <StackPanel Grid.Row="1" Padding="24,18,24,12" Spacing="10">

                <!-- Row 1: Transfer Date / Time -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" Transfer Date / Time :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBox x:Name="TransferDateBox" Text="07/10/2017" Width="100" Height="24" FontSize="11" Padding="6,2" VerticalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                        <TextBlock Text="•" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBox x:Name="TransferTimeBox" Text="1414" Width="55" Height="24" FontSize="11" Padding="6,2" VerticalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                        <TextBlock Text="• CDT" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Performed By -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" Performed By :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>

                    <Grid Grid.Column="1" Width="230" HorizontalAlignment="Left">
                        <TextBox x:Name="PerformedByBox" Text="TTP , Nurse" Height="24" FontSize="11" Padding="6,2,26,2" VerticalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                        <Border HorizontalAlignment="Right" Width="24" Height="24" Background="Transparent" VerticalAlignment="Center" Padding="4">
                            <FontIcon Glyph="&#xE721;" FontSize="11" Foreground="#0284C7" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== SECTION 1: PATIENT INFORMATION ==================== -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Patient Information" FontSize="11.5" FontWeight="Bold" Foreground="#0B538C" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Rectangle Grid.Column="1" Height="1" Fill="#CBD5E1" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Patient ID -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" Patient ID :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="120" HorizontalAlignment="Left">
                        <TextBox x:Name="PatientIdBox" Text="TTPTEST" Height="24" FontSize="11" Padding="6,2,24,2" VerticalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                        <Border HorizontalAlignment="Right" Width="24" Height="24" Background="Transparent" VerticalAlignment="Center" Padding="4">
                            <FontIcon Glyph="&#xE721;" FontSize="11" Foreground="#0284C7" />
                        </Border>
                    </Grid>

                    <!-- Patient Name -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" Patient Name :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>
                    <TextBox x:Name="PatientNameBox" Grid.Column="3" Text="PATIENT02" Width="190" Height="24" FontSize="11" Padding="6,2" VerticalContentAlignment="Center" HorizontalAlignment="Left" BorderBrush="#94A3B8" BorderThickness="1" Background="White" Foreground="#0F172A" />
                </Grid>

                <!-- ==================== SECTION 2: CURRENT BED INFORMATION ==================== -->
                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Current Bed Information" FontSize="11.5" FontWeight="Bold" Foreground="#0B538C" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Rectangle Grid.Column="1" Height="1" Fill="#CBD5E1" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Current Department -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" Current Department :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>
                    <ComboBox x:Name="CurrentDepartmentCombo" Grid.Column="1" SelectedIndex="0" Width="180" Height="24" FontSize="11" Padding="6,2" HorizontalAlignment="Left">
                        <ComboBoxItem Content="General Medicine" />
                        <ComboBoxItem Content="Emergency Department" />
                        <ComboBoxItem Content="Intensive Care Unit" />
                        <ComboBoxItem Content="Cardiology Ward" />
                        <ComboBoxItem Content="Pediatrics" />
                        <ComboBoxItem Content="Surgical Ward" />
                    </ComboBox>

                    <!-- Transfer Type -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" Transfer Type :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>
                    <ComboBox x:Name="TransferTypeCombo" Grid.Column="3" SelectedIndex="0" Width="190" Height="24" FontSize="11" Padding="6,2" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Within Hospital" />
                        <ComboBoxItem Content="External Facility" />
                        <ComboBoxItem Content="Step Down" />
                        <ComboBoxItem Content="Step Up" />
                        <ComboBoxItem Content="ICU Transfer" />
                    </ComboBox>
                </Grid>

                <!-- ==================== SECTION 3: NEW BED INFORMATION ==================== -->
                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="New Bed Information" FontSize="11.5" FontWeight="Bold" Foreground="#0B538C" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Rectangle Grid.Column="1" Height="1" Fill="#CBD5E1" VerticalAlignment="Center" />
                </Grid>

                <!-- New Department -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" New Department :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>
                    <ComboBox x:Name="NewDepartmentCombo" Grid.Column="1" SelectedIndex="0" Width="190" Height="24" FontSize="11" Padding="6,2" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Cardiology" />
                        <ComboBoxItem Content="General Medicine" />
                        <ComboBoxItem Content="Neurology" />
                        <ComboBoxItem Content="Orthopedics" />
                        <ComboBoxItem Content="Intensive Care Unit" />
                        <ComboBoxItem Content="Oncology" />
                    </ComboBox>
                </Grid>

                <!-- New Ward -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="*" Foreground="#DC2626" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" New Ward :" Foreground="#1E293B" FontSize="11" />
                    </StackPanel>
                    <ComboBox x:Name="NewWardCombo" Grid.Column="1" SelectedIndex="0" Width="190" Height="24" FontSize="11" Padding="6,2" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Cardiac Ward - 1" />
                        <ComboBoxItem Content="Cardiac Ward - 2" />
                        <ComboBoxItem Content="ICU Step-down" />
                        <ComboBoxItem Content="Telemetry Unit" />
                        <ComboBoxItem Content="General Ward B" />
                    </ComboBox>
                </Grid>

            </StackPanel>

            <!-- ==================== 2. FOOTER ACTIONS ==================== -->
            <Border Grid.Row="2" Padding="24,0,24,18">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Width="75"
                            Height="28"
                            Background="#205493"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="11"
                            CornerRadius="3"
                            Click="OnSaveClicked" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Width="75"
                            Height="28"
                            Background="#FFFFFF"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            Foreground="#1E293B"
                            FontSize="11"
                            CornerRadius="3"
                            Click="OnCancelClicked" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
