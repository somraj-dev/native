<UserControl
    x:Class="AxioVital.Desktop.Views.PendingTransferWarningDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <!-- Outer Dialog Window Container -->
    <Border Width="510"
            Background="#FFFFFF"
            BorderBrush="#94A3B8"
            BorderThickness="1"
            CornerRadius="3">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Title Bar -->
                <RowDefinition Height="28" />
                <!-- 1. Content Area -->
                <RowDefinition Height="*" />
                <!-- 2. Action Buttons Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 0. TITLE BAR ==================== -->
            <Border Grid.Row="0" BorderBrush="#B0C4DE" BorderThickness="0,0,0,1" CornerRadius="2,2,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EAF2FA" Offset="0.0" />
                        <GradientStop Color="#D2E3F4" Offset="0.5" />
                        <GradientStop Color="#BDD6EE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Padding="10,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="DialogTitleText"
                               Grid.Column="0"
                               Text="Cancel Pending Transfer"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center" />

                    <!-- Red Close Button ✕ -->
                    <Button Grid.Column="1"
                            Width="26"
                            Height="18"
                            Padding="0"
                            Margin="0"
                            MinHeight="0"
                            MinWidth="0"
                            Background="#D32F2F"
                            BorderThickness="0"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Click="OnCancelClicked">
                        <TextBlock Text="✕"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== 1. BODY CONTENT ==================== -->
            <Grid Grid.Row="1" Padding="20,18,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Blue Circular Question Mark Badge -->
                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        Background="#1D6FA5"
                        CornerRadius="18"
                        VerticalAlignment="Top"
                        Margin="0,0,16,0">
                    <TextBlock Text="?"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0" />
                </Border>

                <!-- Warning Message Text -->
                <TextBlock x:Name="WarningMessageText"
                           Grid.Column="1"
                           FontSize="11"
                           Foreground="#1E293B"
                           TextWrapping="Wrap"
                           LineHeight="17"
                           VerticalAlignment="Top"
                           Text="This patient currently has a pending transfer to LGH HOPE Centre/LGH HOPE Centre/LGH MIU//&#x0a;with an estimated complete date and time of .&#x0a;Would you like to complete the pending transfer?" />
            </Grid>

            <!-- ==================== 2. BUTTONS FOOTER ==================== -->
            <Border Grid.Row="2" Padding="20,0,20,16">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <!-- Yes Button -->
                    <Button x:Name="YesButton"
                            Content="Yes"
                            Width="80"
                            Height="26"
                            Background="#F8FAFC"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="3"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            Click="OnYesClicked" />

                    <!-- No Button -->
                    <Button x:Name="NoButton"
                            Content="No"
                            Width="80"
                            Height="26"
                            Background="#F8FAFC"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="3"
                            FontSize="11"
                            Foreground="#0F172A"
                            Click="OnNoClicked" />

                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Width="80"
                            Height="26"
                            Background="#F8FAFC"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="3"
                            FontSize="11"
                            Foreground="#0F172A"
                            Click="OnCancelClicked" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
