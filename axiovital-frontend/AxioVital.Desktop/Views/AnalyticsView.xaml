<UserControl
    x:Class="AxioVital.Desktop.Views.AnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI">

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="195" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR NAVIGATION ==================== -->
        <Border Grid.Column="0" Background="#DDE7EE" BorderBrush="#CBD7DF" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Sidebar Title Header -->
                    <RowDefinition Height="28" />
                    <!-- Navigation Menu Items -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sidebar Title -->
                <Border Grid.Row="0" Background="#5F8299" Padding="10,4">
                    <TextBlock Text="Analytics" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </Border>

                <!-- Sidebar Menu List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,8,6,8">
                    <StackPanel Spacing="3">
                        <!-- Dashboards Section (Expanded by default) -->
                        <Border x:Name="DashboardsHeader" Background="Transparent" Padding="4,4" Margin="0,2,0,0" PointerPressed="OnDashboardsHeaderClicked">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#E68A00" />
                                    <TextBlock Text="Dashboards" FontSize="10.5" FontWeight="Bold" Foreground="#111111" />
                                </StackPanel>
                                <TextBlock x:Name="DashboardsArrow" Text="▾" FontSize="10" Foreground="#334455" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel x:Name="DashboardsContent" Visibility="Visible" Spacing="2">
                            <!-- Overview (Active Selected Pill) -->
                            <Border x:Name="OverviewItemBorder" Background="#0A658E" CornerRadius="4" Padding="12,5" Margin="4,1,4,1" PointerPressed="OnSidebarItemClicked">
                                <TextBlock Text="Overview" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                            </Border>

                            <Border Background="Transparent" CornerRadius="4" Padding="12,4" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Patient Population" FontSize="10" Foreground="#222222" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,4" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Quality Measures" FontSize="10" Foreground="#222222" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,4" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Operational Metrics" FontSize="10" Foreground="#222222" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,4" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Financial Performance" FontSize="10" Foreground="#222222" /></Border>
                        </StackPanel>

                        <!-- Clinical Analytics Section -->
                        <Border x:Name="ClinicalAnalyticsHeader" Background="Transparent" Padding="4,5" Margin="0,4,0,0" PointerPressed="OnClinicalAnalyticsHeaderClicked">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#E68A00" />
                                    <TextBlock Text="Clinical Analytics" FontSize="10" FontWeight="SemiBold" Foreground="#222222" />
                                </StackPanel>
                                <TextBlock x:Name="ClinicalAnalyticsArrow" Text="▴" FontSize="10" Foreground="#334455" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="ClinicalAnalyticsContent" Visibility="Collapsed" Spacing="2">
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Inpatient Outcomes" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Outpatient Metrics" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Infection Control" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Surgical Complications" FontSize="9.5" Foreground="#333333" /></Border>
                        </StackPanel>

                        <!-- Operational Analytics Section -->
                        <Border x:Name="OperationalAnalyticsHeader" Background="Transparent" Padding="4,5" Margin="0,2,0,0" PointerPressed="OnOperationalAnalyticsHeaderClicked">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#E68A00" />
                                    <TextBlock Text="Operational Analytics" FontSize="10" FontWeight="SemiBold" Foreground="#222222" />
                                </StackPanel>
                                <TextBlock x:Name="OperationalAnalyticsArrow" Text="▴" FontSize="10" Foreground="#334455" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="OperationalAnalyticsContent" Visibility="Collapsed" Spacing="2">
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Bed Occupancy &amp; Census" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="ED Throughput &amp; Wait Times" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Staffing &amp; Nurse Ratios" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="OR Utilization" FontSize="9.5" Foreground="#333333" /></Border>
                        </StackPanel>

                        <!-- Financial Analytics Section -->
                        <Border x:Name="FinancialAnalyticsHeader" Background="Transparent" Padding="4,5" Margin="0,2,0,0" PointerPressed="OnFinancialAnalyticsHeaderClicked">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#E68A00" />
                                    <TextBlock Text="Financial Analytics" FontSize="10" FontWeight="SemiBold" Foreground="#222222" />
                                </StackPanel>
                                <TextBlock x:Name="FinancialAnalyticsArrow" Text="▴" FontSize="10" Foreground="#334455" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="FinancialAnalyticsContent" Visibility="Collapsed" Spacing="2">
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Revenue Cycle &amp; Billing" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="DRG &amp; Case Mix Index" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Claims Denial Rates" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Cost Per Encounter" FontSize="9.5" Foreground="#333333" /></Border>
                        </StackPanel>

                        <!-- Custom Reports Section (Expanded) -->
                        <Border x:Name="CustomReportsHeader" Background="Transparent" Padding="4,5" Margin="0,2,0,0" PointerPressed="OnCustomReportsHeaderClicked">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#E68A00" />
                                    <TextBlock Text="Custom Reports" FontSize="10" FontWeight="SemiBold" Foreground="#222222" />
                                </StackPanel>
                                <TextBlock x:Name="CustomReportsArrow" Text="▾" FontSize="10" Foreground="#334455" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="CustomReportsContent" Visibility="Visible" Spacing="2">
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,0" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Saved Reports" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,0" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Report Builder" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,0" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Scheduled Reports" FontSize="9.5" Foreground="#333333" /></Border>
                        </StackPanel>

                        <!-- Data Management Section -->
                        <Border x:Name="DataManagementHeader" Background="Transparent" Padding="4,5" Margin="0,4,0,0" PointerPressed="OnDataManagementHeaderClicked">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#E68A00" />
                                    <TextBlock Text="Data Management" FontSize="10" FontWeight="SemiBold" Foreground="#222222" />
                                </StackPanel>
                                <TextBlock x:Name="DataManagementArrow" Text="▴" FontSize="10" Foreground="#334455" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="DataManagementContent" Visibility="Collapsed" Spacing="2">
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Data Source Integrations" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="ETL Pipelines &amp; Sync" FontSize="9.5" Foreground="#333333" /></Border>
                            <Border Background="Transparent" CornerRadius="4" Padding="12,3" Margin="4,1" PointerPressed="OnSidebarItemClicked"><TextBlock Text="Audit &amp; Access Logs" FontSize="9.5" Foreground="#333333" /></Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================== MAIN DASHBOARD CONTENT ==================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,10,14,14">
            <StackPanel Spacing="10">

                <!-- Sub Tab: Analytics Overview -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="14,4">
                        <TextBlock Text="Analytics Overview" Foreground="#1E293B" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- ==================== 1. FILTER CONTROLS BAR ==================== -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,-10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Dropdown Filters -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Date Range:" Foreground="#475569" FontSize="10.5" VerticalAlignment="Center" />
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="24" Width="110" Padding="6,0" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="Last 30 Days" Foreground="#1E293B" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="▾" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Facility:" Foreground="#475569" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="24" Width="100" Padding="6,0" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="All Facilities" Foreground="#1E293B" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="▾" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Department:" Foreground="#475569" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="24" Width="120" Padding="6,0" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="All Departments" Foreground="#1E293B" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="▾" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Provider:" Foreground="#475569" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="24" Width="105" Padding="6,0" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="All Providers" Foreground="#1E293B" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="▾" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Apply Button -->
                            <Button Content="Apply" Background="#0A3B5C" Foreground="White" FontSize="10.5" FontWeight="Bold" Padding="14,2" Height="24" CornerRadius="3" MinHeight="0" MinWidth="0" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>

                        <!-- Right: Export Button -->
                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="24" Width="76" Padding="8,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="Export" Foreground="#1E293B" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="▾" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== 2. FIVE KPI METRIC CARDS ==================== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Total Patients -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Total Patients" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE77B;" FontSize="11" Foreground="#6B21A8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="12,842" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="▲ 0.4% vs. Prior 30 Days" Foreground="#16A34A" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Encounters -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Encounters" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE9D2;" FontSize="11" Foreground="#4F46E5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="18,729" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="▲ 6.7% vs. Prior 30 Days" Foreground="#16A34A" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Average LOS (Days) -->
                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Average LOS (Days)" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="4.6" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="▼ 5.2% vs. Prior 30 Days" Foreground="#DC2626" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Readmission Rate -->
                    <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Readmission Rate" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE777;" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="11.3%" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="▼ 1.4% vs. Prior 30 Days" Foreground="#16A34A" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 5: Mortality Rate -->
                    <Border Grid.Column="8" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Mortality Rate" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="#DB2777" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="1.2%" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="▲ 0.3% vs. Prior 30 Days" Foreground="#DC2626" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== 3. MIDDLE SECTION: CUSTOMIZE & TREND ANALYSIS ==================== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Customize Panel -->
                        <ColumnDefinition Width="255" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="10" />
                        <!-- Trend Analysis Chart -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Customize Card -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel Spacing="8">
                            <!-- Title & Info Icon -->
                            <Grid>
                                <TextBlock Text="Customize" Foreground="#0F172A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Width="13" Height="13" Background="#38BDF8" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="i" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                            </Grid>

                            <!-- Segmented Toggle Buttons -->
                            <Grid Background="#F1F5F9" CornerRadius="3" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="0,3">
                                    <TextBlock Text="Target" Foreground="#0F172A" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Padding="0,3">
                                    <TextBlock Text="Metric" Foreground="#64748B" FontSize="9.5" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Padding="0,3">
                                    <TextBlock Text="Outcome" Foreground="#64748B" FontSize="9.5" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>

                            <TextBlock Text="Select a metric and set targets to monitor performance." Foreground="#64748B" FontSize="9" TextWrapping="Wrap" />

                            <!-- Metric Dropdown -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="Metric" Foreground="#475569" FontSize="9.5" FontWeight="SemiBold" />
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="24" Padding="8,0">
                                    <Grid>
                                        <TextBlock Text="30-Day Readmission Rate" Foreground="#1E293B" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="▾" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Targets Grid Summary -->
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <Grid>
                                    <TextBlock Text="Target" Foreground="#64748B" FontSize="9.5" />
                                    <TextBlock Text="&lt;= 12.0%" Foreground="#0F172A" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Predicted" Foreground="#64748B" FontSize="9.5" />
                                    <TextBlock Text="10.8%" Foreground="#0F172A" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Current" Foreground="#64748B" FontSize="9.5" />
                                    <TextBlock Text="11.3%" Foreground="#0F172A" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Benchmark & Top Performer -->
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <Grid>
                                    <TextBlock Text="Benchmark" Foreground="#64748B" FontSize="9.5" />
                                    <TextBlock Text="9.6%" Foreground="#334155" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Top Performer" Foreground="#64748B" FontSize="9.5" />
                                    <TextBlock Text="7.2%" Foreground="#334155" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Edit Target Action Button -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="9.5" Foreground="#EA580C" />
                                    <TextBlock Text="Edit Target" Foreground="#0F172A" FontSize="9.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Trend Analysis Chart Card -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Chart Title, Legend & Dropdowns -->
                                <RowDefinition Height="Auto" />
                                <!-- Chart Graphic Scalable Viewbox -->
                                <RowDefinition Height="*" MinHeight="200" />
                            </Grid.RowDefinitions>

                            <!-- Chart Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Title -->
                                <TextBlock Grid.Column="0" Text="Trend Analysis" Foreground="#0F172A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />

                                <!-- Legend -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Actual -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Stroke="#0284C7" StrokeThickness="1.5" Fill="#0284C7" />
