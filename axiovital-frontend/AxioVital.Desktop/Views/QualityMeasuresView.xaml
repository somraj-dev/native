<UserControl
    x:Class="AxioVital.Desktop.Views.QualityMeasuresView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <!-- Main Content: Left Filter Panel + Right Analytics Panel -->
            <RowDefinition Height="*" />
            <!-- Bottom Sub-Tabs Navigation Strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== MAIN SPLIT CONTENT ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Left Input Controls Sidebar -->
                <ColumnDefinition x:Name="LeftPaneCol" Width="250" />
                <!-- Right Main Analytics & Data Grid -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT FILTER SIDEBAR ==================== -->
            <Border Grid.Column="0" Background="#F4F6F4" BorderBrush="#D0D5DA" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Action Buttons Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Filter Inputs List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header with Title and Collapse Button -->
                    <Grid Grid.Row="0" Background="#E5E8E5" Padding="8,6,6,6" BorderBrush="#CCD1CC" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Input Controls - A&amp;E Attendances by Age, Sex and Diagnoses" 
                                   Foreground="#222222" 
                                   FontSize="10.5" 
                                   FontWeight="Bold" 
                                   TextWrapping="Wrap" 
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4,2" 
                                MinHeight="0" 
                                MinWidth="0" 
                                VerticalAlignment="Center" 
                                Click="OnToggleSidebarClick">
                            <TextBlock Text="▲" Foreground="#0A658E" FontSize="10" />
                        </Button>
                    </Grid>

                    <!-- Action Bar (* New and Reset) -->
                    <Grid Grid.Row="1" Background="#ECEEEB" Padding="8,4" BorderBrush="#D5DAD5" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                            <!-- * New Button -->
                            <Button Padding="6,2" Height="22" MinHeight="0" MinWidth="0" Background="#FFFFFF" BorderBrush="#B8BDBA" BorderThickness="1" CornerRadius="2" Click="OnNewFilterClick">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="*" Foreground="#E67E22" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="New" Foreground="#333333" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Reset Button -->
                            <Button Padding="8,2" Height="22" MinHeight="0" MinWidth="0" Background="#FFFFFF" BorderBrush="#B8BDBA" BorderThickness="1" CornerRadius="2" Click="OnResetFilterClick">
                                <TextBlock Text="Reset" Foreground="#333333" FontSize="10.5" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Filter Options -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,8,10,12">
                        <StackPanel Spacing="10">

                            <!-- Filter 1: Diagnosis Code Parent Concept Description -->
                            <StackPanel Spacing="3">
                                <Grid>
                                    <TextBlock Text="Diagnosis Code Parent Concept Description ..." 
                                               Foreground="#222222" 
                                               FontSize="10" 
                                               FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Width="14" Height="14" CornerRadius="7" Background="#DCE8F0" BorderBrush="#8CAFC4" BorderThickness="1">
                                        <TextBlock Text="i" Foreground="#0A658E" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                </Grid>
                                <ComboBox x:Name="DiagnosisParentCombo" SelectedIndex="0" HorizontalAlignment="Stretch" Height="24" FontSize="10.5" Padding="6,1" Background="White" BorderBrush="#B8C3CC" CornerRadius="2">
                                    <ComboBoxItem Content="All values" />
                                    <ComboBoxItem Content="Accidental Injury" />
                                    <ComboBoxItem Content="Assault" />
                                    <ComboBoxItem Content="Self Harm" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Filter 2: Drug-related Diagnosis Concept Ind -->
                            <StackPanel Spacing="3">
                                <Grid>
                                    <TextBlock Text="Drug-related Diagnosis Concept Ind" 
                                               Foreground="#222222" 
                                               FontSize="10" 
                                               FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Width="14" Height="14" CornerRadius="7" Background="#DCE8F0" BorderBrush="#8CAFC4" BorderThickness="1">
                                        <TextBlock Text="i" Foreground="#0A658E" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                </Grid>
                                <ComboBox x:Name="DrugRelatedCombo" SelectedIndex="0" HorizontalAlignment="Stretch" Height="24" FontSize="10.5" Padding="6,1" Background="White" BorderBrush="#B8C3CC" CornerRadius="2">
                                    <ComboBoxItem Content="All values" />
                                    <ComboBoxItem Content="Yes" />
                                    <ComboBoxItem Content="No" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Filter 3: Restricted Diagnosis Ancestor Concept Des... -->
                            <StackPanel Spacing="3">
                                <Grid>
                                    <TextBlock Text="Restricted Diagnosis Ancestor Concept Des..." 
                                               Foreground="#222222" 
                                               FontSize="10" 
                                               FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Width="14" Height="14" CornerRadius="7" Background="#DCE8F0" BorderBrush="#8CAFC4" BorderThickness="1">
                                        <TextBlock Text="i" Foreground="#0A658E" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                </Grid>
                                <ComboBox x:Name="RestrictedDiagnosisCombo" SelectedIndex="0" HorizontalAlignment="Stretch" Height="24" FontSize="10.5" Padding="6,1" Background="White" BorderBrush="#5C93C4" CornerRadius="2">
                                    <ComboBoxItem Content="Traumatic injury" />
                                    <ComboBoxItem Content="Non-traumatic injury" />
                                    <ComboBoxItem Content="All values" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Filter 4: Head Finding Concept Ind -->
                            <StackPanel Spacing="3">
                                <Grid>
                                    <TextBlock Text="Head Finding Concept Ind" 
                                               Foreground="#222222" 
                                               FontSize="10" 
                                               FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Width="14" Height="14" CornerRadius="7" Background="#DCE8F0" BorderBrush="#8CAFC4" BorderThickness="1">
                                        <TextBlock Text="i" Foreground="#0A658E" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                </Grid>
                                <ComboBox x:Name="HeadFindingCombo" SelectedIndex="0" HorizontalAlignment="Stretch" Height="24" FontSize="10.5" Padding="6,1" Background="White" BorderBrush="#B8C3CC" CornerRadius="2">
                                    <ComboBoxItem Content="All values" />
                                    <ComboBoxItem Content="Yes" />
                                    <ComboBoxItem Content="No" />
                                </ComboBox>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ==================== RIGHT MAIN ANALYTICS VIEW ==================== -->
            <Grid Grid.Column="1" Background="#FFFFFF" Padding="14,10,14,6">
                <Grid.RowDefinitions>
                    <!-- Page Banner Title -->
                    <RowDefinition Height="Auto" />
                    <!-- Divider Line -->
                    <RowDefinition Height="Auto" />
                    <!-- Grouped Column Bar Chart -->
                    <RowDefinition Height="255" />
                    <!-- Data Table -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Banner Title -->
                <TextBlock Grid.Row="0" 
                           Text="A&amp;E Attendances for the period DD/MM/YYYY to DD/MM/YYYY with a Diagnoses descendent concept of Traumatic injury" 
                           Foreground="#111111" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,0,4" />

                <!-- 2. Divider Line -->
                <Rectangle Grid.Row="1" Height="1" Fill="#CBD0D6" HorizontalAlignment="Stretch" Margin="0,0,0,6" />

                <!-- 3. Grouped Column Bar Chart Section -->
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <!-- Chart Area -->
                        <ColumnDefinition Width="*" />
                        <!-- Legend Box on Right -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Chart Grid and Columns -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <!-- Y Axis Label -->
                            <ColumnDefinition Width="20" />
                            <!-- Y Axis Numbers & Ticks -->
                            <ColumnDefinition Width="26" />
                            <!-- Plot Area -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- Plot Area + Y Axis Scale -->
                            <RowDefinition Height="185" />
                            <!-- X Axis Band Labels -->
                            <RowDefinition Height="18" />
                            <!-- X Axis Title "Age Band" -->
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>

                        <!-- Rotated Y-Axis Label -->
                        <Grid Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Count of Attendances" 
                                       Foreground="#222222" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <!-- Y-Axis Values (0, 20, 40, 60, 80, 100, 120, 140, 160) -->
                        <Grid Grid.Column="1" Grid.Row="0" Margin="0,10,4,15">
                            <TextBlock Text="160" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,0,0" />
                            <TextBlock Text="140" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,15,0,0" />
                            <TextBlock Text="120" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,35,0,0" />
                            <TextBlock Text="100" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,55,0,0" />
                            <TextBlock Text="80" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,74,0,0" />
                            <TextBlock Text="60" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,94,0,0" />
                            <TextBlock Text="40" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,113,0,0" />
                            <TextBlock Text="20" Foreground="#555555" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,133,0,0" />
                            <TextBlock Text="0" Foreground="#555555" FontSize="8.5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-6" />
                        </Grid>

                        <!-- Plot Area with Horizontal Gridlines and 18 Grouped Bars -->
                        <Grid Grid.Column="2" Grid.Row="0" Margin="0,10,0,15">
                            <!-- Dashed Horizontal Gridlines -->
                            <Grid VerticalAlignment="Stretch">
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,0,0,0" />
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,20,0,0" />
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,40,0,0" />
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,60,0,0" />
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,79,0,0" />
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,99,0,0" />
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,118,0,0" />
                                <Rectangle Height="1" Fill="#ECECEC" VerticalAlignment="Top" Margin="0,138,0,0" />
                                <!-- Solid Baseline at 0 -->
                                <Rectangle Height="1" Fill="#888888" VerticalAlignment="Bottom" Margin="0,0,0,0" />
                            </Grid>

                            <!-- Grouped Column Bars Container (18 exact static columns) -->
                            <Grid VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="155">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 1. Age Band: 00 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="00: Female 0, Male 20">
                                    <Border Width="11" Height="0" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="19" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 2. Age Band: 01-04 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="01-04: Female 88, Male 105">
                                    <Border Width="11" Height="85" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="102" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 3. Age Band: 05-09 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="05-09: Female 60, Male 78">
                                    <Border Width="11" Height="58" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="76" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 4. Age Band: 10-14 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="10-14: Female 110, Male 108">
                                    <Border Width="11" Height="107" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="105" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 5. Age Band: 15-19 (Peak) -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="15-19: Female 88, Male 146">
                                    <Border Width="11" Height="85" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="142" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 6. Age Band: 20-24 -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="20-24: Female 92, Male 132">
                                    <Border Width="11" Height="89" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="128" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 7. Age Band: 25-29 -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="25-29: Female 95, Male 126">
                                    <Border Width="11" Height="92" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="122" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 8. Age Band: 30-34 -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="30-34: Female 88, Male 80">
                                    <Border Width="11" Height="85" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="78" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 9. Age Band: 35-39 -->
                                <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="35-39: Female 52, Male 68">
                                    <Border Width="11" Height="50" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="66" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 10. Age Band: 40-44 -->
                                <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="40-44: Female 59, Male 80">
                                    <Border Width="11" Height="57" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="78" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 11. Age Band: 45-49 -->
                                <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="45-49: Female 78, Male 75">
                                    <Border Width="11" Height="76" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="73" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 12. Age Band: 50-54 -->
                                <StackPanel Grid.Column="11" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="50-54: Female 72, Male 70">
                                    <Border Width="11" Height="70" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="68" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 13. Age Band: 55-59 -->
                                <StackPanel Grid.Column="12" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="55-59: Female 60, Male 48">
                                    <Border Width="11" Height="58" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="47" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 14. Age Band: 60-64 -->
                                <StackPanel Grid.Column="13" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="60-64: Female 52, Male 35">
                                    <Border Width="11" Height="50" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="34" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 15. Age Band: 65-69 -->
                                <StackPanel Grid.Column="14" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="65-69: Female 32, Male 30">
                                    <Border Width="11" Height="31" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="29" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 16. Age Band: 70-74 -->
                                <StackPanel Grid.Column="15" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="70-74: Female 38, Male 30">
                                    <Border Width="11" Height="37" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="29" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 17. Age Band: 80-84 -->
                                <StackPanel Grid.Column="16" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="80-84: Female 48, Male 32">
                                    <Border Width="11" Height="47" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="31" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <!-- 18. Age Band: 85+ -->
                                <StackPanel Grid.Column="17" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="0" ToolTipService.ToolTip="85+: Female 60, Male 18">
                                    <Border Width="11" Height="58" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                    <Border Width="11" Height="17" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8,0.8,0.8,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- X-Axis Category Labels -->
                        <Grid Grid.Column="2" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="00" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="01-04" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="05-09" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="10-14" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="15-19" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="20-24" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="25-29" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="30-34" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="35-39" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="9" Text="40-44" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="10" Text="45-49" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="11" Text="50-54" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="12" Text="55-59" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="13" Text="60-64" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="14" Text="65-69" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="15" Text="70-74" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="16" Text="80-84" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="17" Text="85+" FontSize="8" Foreground="#333333" HorizontalAlignment="Center" />
                        </Grid>

                        <!-- Centered X-Axis Title "Age Band" -->
                        <TextBlock Grid.Column="2" Grid.Row="2" Text="Age Band" Foreground="#222222" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </Grid>

                    <!-- Legend Box on Far Right -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D0D5DA" BorderThickness="1" Padding="8,8" Margin="14,6,4,20" VerticalAlignment="Top" Width="82">
                        <StackPanel Spacing="6">
                            <!-- Stacked Title -->
                            <StackPanel Spacing="0">
                                <TextBlock Text="Patient" FontSize="9" Foreground="#555555" />
                                <TextBlock Text="Gender" FontSize="9" Foreground="#555555" />
                                <TextBlock Text="Current" FontSize="9" Foreground="#555555" />
                                <TextBlock Text="NHS" FontSize="9" Foreground="#555555" />
                                <TextBlock Text="Code" FontSize="9" Foreground="#555555" />
                                <TextBlock Text="Desc" FontSize="9" Foreground="#555555" />
                            </StackPanel>

                            <!-- Legend Item: Female -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="11" Height="11" Background="#FFFF66" BorderBrush="#444444" BorderThickness="0.8" />
                                <TextBlock Text="Female" FontSize="9" Foreground="#222222" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Legend Item: Male -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="11" Height="11" Background="#2E66E6" BorderBrush="#1A3B8B" BorderThickness="0.8" />
                                <TextBlock Text="Male" FontSize="9" Foreground="#222222" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. Data Table Section -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD0D6" BorderThickness="1" Margin="0,2,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header -->
                            <RowDefinition Height="30" />
                            <!-- Table Rows -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Deep Slate Blue Table Header -->
                        <Grid Grid.Row="0" Background="#4A5F9E">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#687BBA" BorderThickness="0,0,1,0" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="A&amp;E Attendance Number" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#687BBA" BorderThickness="0,0,1,0" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="Patient Gender Current NHS Code Desc" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                            </Border>

                            <Border Grid.Column="2" BorderBrush="#687BBA" BorderThickness="0,0,1,0" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="Diagnosis Code Description 1" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                            </Border>

                            <Border Grid.Column="3" BorderBrush="#687BBA" BorderThickness="0,0,1,0" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="Diagnosis Code Description 2" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                            </Border>

                            <Border Grid.Column="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="Diagnosis Code Description 3" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <!-- Scrollable Rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AttendanceItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5E8EB" BorderThickness="0,0,0,1" MinHeight="26">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="160" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" BorderBrush="#ECEFF2" BorderThickness="0,0,1,0" Padding="8,5">
                                                    <TextBlock Text="{Binding AttendanceNumber}" Foreground="#222222" FontSize="10" VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="1" BorderBrush="#ECEFF2" BorderThickness="0,0,1,0" Padding="8,5">
                                                    <TextBlock Text="{Binding GenderDesc}" Foreground="#222222" FontSize="10" VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="2" BorderBrush="#ECEFF2" BorderThickness="0,0,1,0" Padding="8,5">
                                                    <TextBlock Text="{Binding Diagnosis1}" Foreground="#222222" FontSize="10" VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="3" BorderBrush="#ECEFF2" BorderThickness="0,0,1,0" Padding="8,5">
                                                    <TextBlock Text="{Binding Diagnosis2}" Foreground="#222222" FontSize="10" VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="4" Padding="8,5">
                                                    <TextBlock Text="{Binding Diagnosis3}" Foreground="#222222" FontSize="10" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== BOTTOM SUB-TABS STRIP ==================== -->
        <Grid Grid.Row="1" Background="#DDE2E8" BorderBrush="#CCD2D8" BorderThickness="0,1,0,0" Height="28" Padding="6,2,6,0">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <!-- Tab 1 (Active): Attendances by Age, Sex and Diagnoses -->
                <Border x:Name="TabAttendancesBorder" 
                        Background="#FFFFFF" 
                        BorderBrush="#BAC3CC" 
                        BorderThickness="1,1,1,0" 
                        CornerRadius="3,3,0,0" 
                        Padding="8,3,10,3" 
                        PointerPressed="OnTabAttendancesPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Attendances by Age, Sex and Diagnoses" Foreground="#111111" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Tab 2: Diagnosis Concept Explode -->
                <Border x:Name="TabDiagnosisBorder" 
                        Background="Transparent" 
                        Padding="8,3,10,3" 
                        PointerPressed="OnTabDiagnosisPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="📑" FontFamily="Segoe UI Emoji" FontSize="10" Foreground="#E67E22" VerticalAlignment="Center" />
                        <TextBlock Text="Diagnosis Concept Explode" Foreground="#444444" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Tab 3: Summary Count -->
                <Border x:Name="TabSummaryBorder" 
                        Background="Transparent" 
                        Padding="8,3,10,3" 
                        PointerPressed="OnTabSummaryPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="📑" FontFamily="Segoe UI Emoji" FontSize="10" Foreground="#E67E22" VerticalAlignment="Center" />
                        <TextBlock Text="Summary Count" Foreground="#444444" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
