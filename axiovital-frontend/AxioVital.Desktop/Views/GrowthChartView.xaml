<UserControl
    x:Class="AxioVital.Desktop.Views.GrowthChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <ScrollViewer Background="#FFFFFF" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <StackPanel Spacing="10" Padding="14,10,14,20" HorizontalAlignment="Stretch">

            <!-- ==================== 1. TOP TITLE HEADER ==================== -->
            <TextBlock Text="Portfolio Slicer - Yearly Movements" 
                       Foreground="#4A7FA8" 
                       FontSize="15" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,0" />

            <!-- ==================== 2. TOP SLICER / FILTER BAR (FULL WIDTH) ==================== -->
            <Border Background="#F8FAFC" BorderBrush="#B8CCE0" BorderThickness="1" CornerRadius="3" Padding="10,8,10,8" HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Slicer Box: Portfolio -->
                    <Border Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Spacing="5">
                            <!-- Slicer Header -->
                            <Grid>
                                <TextBlock Text="Portfolio" FontSize="11.5" FontWeight="Bold" Foreground="#1E3A5F" />
                                <FontIcon Glyph="&#xE71C;" FontSize="13" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Slicer Pills Row 1 & 2 in Wrap/Horizontal Stack -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border x:Name="PillHers" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="12,3" PointerPressed="OnPortfolioPillPressed" Tag="Hers">
                                    <TextBlock Text="Hers" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                                <Border x:Name="PillHersTax" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="12,3" PointerPressed="OnPortfolioPillPressed" Tag="Hers-Tax">
                                    <TextBlock Text="Hers-Tax" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                                <Border x:Name="PillHis" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="14,3" PointerPressed="OnPortfolioPillPressed" Tag="His">
                                    <TextBlock Text="His" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                                <Border x:Name="PillHisCdn" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="12,3" PointerPressed="OnPortfolioPillPressed" Tag="His-CDN">
                                    <TextBlock Text="His-CDN" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                                <Border x:Name="PillHisTax" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="12,3" PointerPressed="OnPortfolioPillPressed" Tag="His-Tax">
                                    <TextBlock Text="His-Tax" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                                <Border x:Name="PillJoint" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="14,3" PointerPressed="OnPortfolioPillPressed" Tag="Joint">
                                    <TextBlock Text="Joint" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right Slicer Box: Report Currency -->
                    <Border Grid.Column="1" BorderBrush="#CBD7E3" BorderThickness="1,0,0,0" Padding="16,0,0,0" MinWidth="260">
                        <StackPanel Spacing="5">
                            <!-- Slicer Header -->
                            <Grid>
                                <TextBlock Text="Report Currency" FontSize="11.5" FontWeight="Bold" Foreground="#1E3A5F" />
                                <FontIcon Glyph="&#xE71C;" FontSize="13" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Currency Pills -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border x:Name="PillOrigCurrency" Background="#165B8C" BorderBrush="#0F4368" BorderThickness="1" CornerRadius="3" Padding="12,3" PointerPressed="OnCurrencyPillPressed" Tag="Original">
                                    <TextBlock Text="*Original*" FontSize="13" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="PillCadCurrency" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="12,3" PointerPressed="OnCurrencyPillPressed" Tag="CAD">
                                    <TextBlock Text="CAD" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                                <Border x:Name="PillUsdCurrency" Background="#CBDCEB" BorderBrush="#9DBAD6" BorderThickness="1" CornerRadius="3" Padding="12,3" PointerPressed="OnCurrencyPillPressed" Tag="USD">
                                    <TextBlock Text="USD" FontSize="13" Foreground="#1E3A5F" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== 3. SECTION: YEARLY MOVEMENTS SUMMARY TABLE (FULL WIDTH) ==================== -->
            <Border BorderBrush="#165B8C" BorderThickness="1" Background="#FFFFFF" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Sub-Header Title Bar with Filter Badge -->
                    <Grid Background="#F0F5FA" Padding="8,4,8,4" BorderBrush="#D0DEEB" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                        <!-- Left Filter Badge -->
                        <Border HorizontalAlignment="Left" Background="#E6EFF7" BorderBrush="#94B8D7" BorderThickness="1" CornerRadius="2" Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Years - Last 7" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E3A5F" />
                                <TextBlock Text="Yes" FontSize="11.5" Foreground="#334455" />
                                <FontIcon Glyph="&#xE71C;" FontSize="8.5" Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Center Title & Formula -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="Yearly movements" FontSize="12.5" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="Growth = TotalValue - StartValue - Deposits" FontSize="12" Foreground="#0284C7" FontStyle="Italic" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Data Grid Table Stretched Across Full Width -->
                    <Grid Background="#FFFFFF" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" /> <!-- Header -->
                            <RowDefinition Height="28" /> <!-- 2013 -->
                            <RowDefinition Height="28" /> <!-- 2012 -->
                            <RowDefinition Height="28" /> <!-- 2011 -->
                            <RowDefinition Height="28" /> <!-- 2010 -->
                            <RowDefinition Height="28" /> <!-- 2009 -->
                            <RowDefinition Height="28" /> <!-- 2008 -->
                            <RowDefinition Height="28" /> <!-- Grand Total -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" MinWidth="60" />  <!-- Year -->
                            <ColumnDefinition Width="1.1*" MinWidth="85" />  <!-- Start Value -->
                            <ColumnDefinition Width="1.0*" MinWidth="75" />  <!-- Deposits -->
                            <ColumnDefinition Width="1.0*" MinWidth="75" />  <!-- Dividends -->
                            <ColumnDefinition Width="1.1*" MinWidth="85" />  <!-- Capital Gain -->
                            <ColumnDefinition Width="1.2*" MinWidth="95" />  <!-- Ending Value -->
                            <ColumnDefinition Width="1.0*" MinWidth="80" />  <!-- Cap Gain % -->
                            <ColumnDefinition Width="1.0*" MinWidth="80" />  <!-- Dividend % -->
                            <ColumnDefinition Width="1.0*" MinWidth="75" />  <!-- Profit % -->
                            <ColumnDefinition Width="1.2*" MinWidth="95" />  <!-- Exch Rate Impact -->
                            <ColumnDefinition Width="1.1*" MinWidth="85" />  <!-- Exch Rate Impact % -->
                        </Grid.ColumnDefinitions>

