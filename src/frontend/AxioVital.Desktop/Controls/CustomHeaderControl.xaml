<UserControl
    x:Class="AxioVital.Desktop.Controls.CustomHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="AxioVital Healthcare Platform" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="System Online" Foreground="Green" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
    </Grid>
</UserControl>
