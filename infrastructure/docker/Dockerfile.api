# Multi-stage Dockerfile for AxioVital ASP.NET Core 9 API

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY ["Directory.Build.props", "."]
COPY ["Directory.Packages.props", "."]
COPY ["src/backend/AxioVital.Domain/AxioVital.Domain.csproj", "src/backend/AxioVital.Domain/"]
COPY ["src/backend/AxioVital.Contracts/AxioVital.Contracts.csproj", "src/backend/AxioVital.Contracts/"]
COPY ["src/backend/AxioVital.Application/AxioVital.Application.csproj", "src/backend/AxioVital.Application/"]
COPY ["src/backend/AxioVital.Infrastructure/AxioVital.Infrastructure.csproj", "src/backend/AxioVital.Infrastructure/"]
COPY ["src/backend/AxioVital.Api/AxioVital.Api.csproj", "src/backend/AxioVital.Api/"]

RUN dotnet restore "src/backend/AxioVital.Api/AxioVital.Api.csproj"

COPY . .
WORKDIR "/src/src/backend/AxioVital.Api"
RUN dotnet build "AxioVital.Api.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "AxioVital.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "AxioVital.Api.dll"]
